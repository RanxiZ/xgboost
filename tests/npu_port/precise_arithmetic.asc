// Test-only entry exercises device arithmetic independently of split scoring.
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#define XGB_NPU_PRECISE_INLINE __aicore__ inline
#include "../../src/common/npu/precise_scoring.h"
#include "precise_arithmetic_abi.h"
namespace p=xgboost::common::npu::precise;
__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void ArithmeticVf(
    __gm__ precise_test::ArithmeticInput const* input,__gm__ precise_test::ArithmeticOutput* output,
    uint32_t count,uint32_t block,uint32_t blocks) {
  for (uint64_t i=static_cast<uint64_t>(block)*128+threadIdx.x;i<count;i+=static_cast<uint64_t>(blocks)*128) {
    p::Arithmetic a; uint64_t v=0; uint32_t op=input[i].operation;
    if (op==0) v=a.Add(input[i].a,input[i].b);
    if (op==1) v=a.Mul(input[i].a,input[i].b);
    if (op==2) v=a.Div(input[i].a,input[i].b);
    if (op==3) v=a.FromInt(static_cast<int64_t>(input[i].a),static_cast<int>(input[i].b));
    if (op==4) v=a.FromFloat(static_cast<uint32_t>(input[i].a));
    if (op==5) v=a.ToFloat(input[i].a);
    output[i].value=v; output[i].error=a.error; output[i].padding=0;
  }
}
extern "C" __global__ __aicore__ void PreciseArithmeticKernel(GM_ADDR input,GM_ADDR output,uint32_t count) {
  asc_vf_call<ArithmeticVf>(dim3(128),reinterpret_cast<__gm__ precise_test::ArithmeticInput const*>(input),
    reinterpret_cast<__gm__ precise_test::ArithmeticOutput*>(output),count,AscendC::GetBlockIdx(),AscendC::GetBlockNum());
}
extern "C" void XgbNpuTestArithmetic(void* stream,void const* input,void* output,uint32_t count) {
  if (!count) return;
  uint32_t blocks=(count-1)/128+1; if (blocks>16) blocks=16;
  PreciseArithmeticKernel<<<blocks,nullptr,stream>>>(
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(input)),
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(output)),count);
}
