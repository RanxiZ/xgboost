#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#define XGB_NPU_PRECISE_INLINE __aicore__ inline
#include "candidate_selection_device.h"
namespace cs=xgboost::common::npu::precise;
// Correctness-first vector-core reduction. The pinned ArgMax is associative
// on finite/-inf gains with unique keys: maximum value then minimum key.
// Reassociate its proven 1,2,4,8,16 tree to a fold to avoid SIMT local-array
// stack overflow. This preserves the selected operand, including zero bits.
__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void SelectCandidatesVf(
    __gm__ cs::Score const* left,__gm__ cs::Score const* right,__gm__ cs::Candidate* output,uint32_t n,uint32_t feature) {
  if (threadIdx.x) return;
  auto best=cs::EmptyCandidate(); uint32_t errors=0;
  for (uint64_t begin=0;begin<n;begin+=32) {
    auto chunk=cs::EmptyCandidate();
    for (uint32_t lane=0;lane<32 && begin+lane<n;++lane) {
      uint64_t i=begin+lane;
      auto value=cs::MakeCandidate(cs::LoadSelectionScore(left+i),cs::LoadSelectionScore(right+i),feature,static_cast<uint32_t>(i));
      errors|=value.error; chunk=cs::LaneArgMax(chunk,value);
    }
    best=cs::UpdateCandidate(best,chunk);
  }
  best.error|=errors; cs::StoreCandidate(output,best);
}
extern "C" __global__ __aicore__ void SelectCandidatesKernel(GM_ADDR left,GM_ADDR right,GM_ADDR output,uint32_t n,uint32_t feature) {
  asc_vf_call<SelectCandidatesVf>(dim3(128),reinterpret_cast<__gm__ cs::Score const*>(left),
    reinterpret_cast<__gm__ cs::Score const*>(right),reinterpret_cast<__gm__ cs::Candidate*>(output),n,feature);
}
extern "C" void XgbNpuSelectCandidates(void* stream,void const* left,void const* right,void* output,uint32_t count,uint32_t feature) {
  if (!count) return;
  SelectCandidatesKernel<<<1,nullptr,stream>>>(reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(left)),
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(right)),reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(output)),count,feature);
}