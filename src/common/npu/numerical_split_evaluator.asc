#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#define XGB_NPU_PRECISE_INLINE __aicore__ inline
#include "numerical_split_evaluator_abi.h"
#include "candidate_selection_device.h"
namespace ne=xgboost::common::npu::precise;
__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void SplitStatisticsVf(
    __gm__ int64_t const* bins,__gm__ int64_t const* parent,
    __gm__ int64_t* missing,__gm__ int64_t* left_missing_right,
    __gm__ int64_t* right_missing_right,__gm__ int64_t* left_missing_left,
    __gm__ int64_t* right_missing_left,uint32_t count) {
  if (threadIdx.x) return;
  // Histogram validation bounds each sign's magnitude by INT64_MAX. Every
  // intermediate below is therefore a disjoint row subset, even with severe
  // cancellation. Two linear passes need no bin-sized local array and support
  // the complete validated 1..INT32_MAX bin range.
  int64_t total = 0;
  for (uint32_t i = 0; i < count; ++i) total += bins[i];
  int64_t root = *parent;
  int64_t residual = root - total;
  *missing = residual;
  int64_t left = 0;
  for (uint32_t i = 0; i < count; ++i) {
    // Store BEFORE consuming bin i; the final bin creates no extra candidate.
    left_missing_right[i] = left;
    right_missing_right[i] = root - left;
    left_missing_left[i] = left + residual;
    right_missing_left[i] = total - left;
    left += bins[i];
  }
}
extern "C" __global__ __aicore__ void SplitStatisticsKernel(
    GM_ADDR bins,GM_ADDR parent,GM_ADDR missing,GM_ADDR left_missing_right,
    GM_ADDR right_missing_right,GM_ADDR left_missing_left,GM_ADDR right_missing_left,
    uint32_t count) {
  asc_vf_call<SplitStatisticsVf>(dim3(128),
    reinterpret_cast<__gm__ int64_t const*>(bins),reinterpret_cast<__gm__ int64_t const*>(parent),
    reinterpret_cast<__gm__ int64_t*>(missing),reinterpret_cast<__gm__ int64_t*>(left_missing_right),
    reinterpret_cast<__gm__ int64_t*>(right_missing_right),reinterpret_cast<__gm__ int64_t*>(left_missing_left),
    reinterpret_cast<__gm__ int64_t*>(right_missing_left),count);
}
extern "C" void XgbNpuSplitStatistics(
    void* stream,void const* bins,void const* parent,void* missing,void* left_missing_right,
    void* right_missing_right,void* left_missing_left,void* right_missing_left,uint32_t count) {
  if (!count) return;
  SplitStatisticsKernel<<<1,nullptr,stream>>>(
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(bins)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(parent)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(missing)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(left_missing_right)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(right_missing_right)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(left_missing_left)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(right_missing_left)),count);
}
__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void SplitInitializeVf(
    __gm__ int64_t const* g,__gm__ int64_t const* h,__gm__ ne::Parameters const* p,__gm__ ne::SplitSummary* s) {
  if (threadIdx.x) return;
  ne::Parameters parameters{p->min_child_weight,p->reg_lambda,p->reg_alpha,p->max_delta_step,p->gradient_scale,p->hessian_scale};
  auto node=ne::NodeQuantities(*g,*h,parameters);
  ne::StoreCandidate(&s->best,ne::EmptyCandidate());
  s->node.weight=node.weight;s->node.gain=node.gain;s->node.error=node.error;s->node.padding=0;
  s->gradient=*g;s->hessian=*h;s->left_gradient=0;s->left_hessian=0;s->right_gradient=0;s->right_hessian=0;
  s->loss_change=0xff800000U;s->error=node.error;
}
__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void SplitMergeVf(
    __gm__ ne::Candidate const* selected,__gm__ uint64_t const* columns,__gm__ ne::SplitSummary* s) {
  if (threadIdx.x) return;
  auto c=ne::LoadCandidate(selected); s->error|=c.error;
  if (!c.valid || !ne::GreaterGain(c.score.gain,s->best.score.gain)) return;
  ne::StoreCandidate(&s->best,c);
  auto offset=c.missing_left?4:0; auto i=c.candidate;
  s->left_gradient=reinterpret_cast<__gm__ int64_t const*>(columns[offset])[i];
  s->left_hessian=reinterpret_cast<__gm__ int64_t const*>(columns[offset+1])[i];
  s->right_gradient=reinterpret_cast<__gm__ int64_t const*>(columns[offset+2])[i];
  s->right_hessian=reinterpret_cast<__gm__ int64_t const*>(columns[offset+3])[i];
}
__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void SplitFinishVf(__gm__ ne::SplitSummary* s) {
  if (threadIdx.x) return;
  auto gain=ne::SubtractParent(s->best.score.gain,s->node.gain);
  s->loss_change=gain.loss_change;s->error|=gain.error;
}
extern "C" __global__ __aicore__ void SplitInitializeKernel(GM_ADDR g,GM_ADDR h,GM_ADDR p,GM_ADDR s) {
  asc_vf_call<SplitInitializeVf>(dim3(128),reinterpret_cast<__gm__ int64_t const*>(g),
    reinterpret_cast<__gm__ int64_t const*>(h),reinterpret_cast<__gm__ ne::Parameters const*>(p),reinterpret_cast<__gm__ ne::SplitSummary*>(s));
}
extern "C" __global__ __aicore__ void SplitMergeKernel(GM_ADDR c,GM_ADDR columns,GM_ADDR s) {
  asc_vf_call<SplitMergeVf>(dim3(128),reinterpret_cast<__gm__ ne::Candidate const*>(c),
    reinterpret_cast<__gm__ uint64_t const*>(columns),reinterpret_cast<__gm__ ne::SplitSummary*>(s));
}
extern "C" __global__ __aicore__ void SplitFinishKernel(GM_ADDR s) {
  asc_vf_call<SplitFinishVf>(dim3(128),reinterpret_cast<__gm__ ne::SplitSummary*>(s));
}
extern "C" void XgbNpuSplitInitialize(void* stream,void const* g,void const* h,void const* p,void* s) {
  SplitInitializeKernel<<<1,nullptr,stream>>>(reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(g)),
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(h)),reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(p)),reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(s)));
}
extern "C" void XgbNpuSplitMerge(void* stream,void const* c,void const* columns,void* s) {
  SplitMergeKernel<<<1,nullptr,stream>>>(reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(c)),
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(columns)),reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(s)));
}
extern "C" void XgbNpuSplitFinish(void* stream,void* s) {
  SplitFinishKernel<<<1,nullptr,stream>>>(reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(s)));
}
// Batched path: independent of the standalone entry points above. All payload
// publication is followed by status=1; fresh, zeroed status detects omissions.
//
// Occupancy redesign. The pre-evolution batched path pins the launch grid to
// min(count,16) blocks and then serialises one thread per feature, so 48 of the
// 64 vector cores never hold work and Prefix/Select run at one lane each. The
// four stages below keep the mandated kernel boundary and launch count but
// change what each stage owns:
//   Prefix  - one warp per feature, single coalesced pass with a 32-lane
//             inclusive scan (no re-read, no per-feature serialisation).
//   Score   - work is re-indexed from "features" to (feature, bin-slice) units,
//             so the grid scales with the candidate count instead of the
//             feature count; the constant part of the IEEE-754 decode is hoisted
//             out of the candidate loop. The producer also folds the slice's
//             argmax in-warp, so the per-candidate record stream that used to
//             travel to Select becomes one record per slice.
//   Select  - one warp per feature over the <=32 slice partials; the total order
//             (gain desc, then smaller candidate index) makes this fold equal to
//             the pinned per-candidate CUB fold.
//   Finish  - the pinned 256-stripe serial scan becomes a warp-sized total-order
//             reduction; per-feature errors are still OR-ed over every feature.
// Prefix and Select own one feature per warp, so their parallelism is capped by
// feature_count. Five warps per block lets a 158-feature launch fill the 32-block
// cap with 160 warps and finish in a single round; at four warps it takes 128
// warps and every warp runs twice. Blocks still track the warp demand, so narrow
// launches simply use fewer blocks.
constexpr uint32_t kBatchThreads=160U;
constexpr uint32_t kBatchLanes=32U;
constexpr uint32_t kBatchWarpsPerBlock=kBatchThreads/kBatchLanes;
// Grid caps: the device exposes 64 vector cores. Warp-grained stages need one
// warp per feature, the candidate stage one warp per (feature, bin slice).
constexpr uint32_t kBatchMaxWarpBlocks=32U;
constexpr uint32_t kBatchMaxScoreBlocks=64U;
// Candidate-stage thread count. Kept separate from kBatchThreads so the two
// warp-grained stages (Prefix/Select) and the candidate stage can be sized
// independently; LAUNCH_BOUND(BatchedSplitScoreVf) and its dim3 must equal it.
constexpr uint32_t kBatchScoreThreads=512U;
constexpr uint32_t kBatchScoreWarpsPerBlock=kBatchScoreThreads/kBatchLanes;
// Candidate-stage slicing: every feature is cut into `BatchSlices` contiguous
// bin slices, one warp each, so a wide-histogram feature still fills the
// machine. The count is a pure function of feature_count, so Score and Select
// agree on the slot layout without reading anything back from the device.
//
// The grain is settled by costs that pull in opposite directions. Every unit
// pays a fixed charge (descriptor fetch, slice-index decode, the in-warp argmax
// fold and the six-word publication) on top of its 32-bin rounds, which argues
// for a coarse grain; the same fixed charge is wasted on a unit that turns out
// to hold no candidate, which argues for not over-cutting a feature. The
// measured balance is that the slot count should track the warp supply with as
// few empty slots as possible, so the target is a fixed number of units per
// core, not per warp: warps per block is itself a tuning knob here (four to
// sixteen warps all fit), whereas the core count is fixed by the device.
constexpr uint32_t kBatchScoreCores=kBatchMaxScoreBlocks;
constexpr uint32_t kBatchSliceUnitsPerCore=8U;
constexpr uint32_t kBatchSliceUnits=kBatchScoreCores*kBatchSliceUnitsPerCore;
constexpr uint32_t kBatchMaxSlices=32U;   // one warp reduces at most 32 partials
static inline uint32_t BatchHostSlices(uint32_t feature_count) {
  if (!feature_count) return 1;
  uint32_t slices=(kBatchSliceUnits+feature_count-1U)/feature_count;
  if (!slices) slices=1;
  if (slices>kBatchMaxSlices) slices=kBatchMaxSlices;
  return slices;
}
// Device mirror of BatchHostSlices; the two must stay identical.
__simt_callee__ inline uint32_t BatchSlices(uint64_t feature_count) {
  if (!feature_count) return 1;
  uint64_t slices=(kBatchSliceUnits+feature_count-1U)/feature_count;
  if (!slices) slices=1;
  if (slices>kBatchMaxSlices) slices=kBatchMaxSlices;
  return static_cast<uint32_t>(slices);
}
// One candidate-stage partial: the slice's own argmax plus the OR of every
// candidate error in the slice. It reuses the DirectionOutput slot verbatim
// (6 words), so the staged array never needs more slots than the candidate
// array it replaces: a feature with B bins owns at most B slots and the slices
// always start inside the feature's own candidate range.
//   word0..3 = Score{left_weight,right_weight,gain,error}
//   word4    = missing_left | (slice_error << 8)
//   word5    = winning candidate index
constexpr uint32_t kBatchPartialShift=8U;
// A slice is widened to a whole number of warp iterations. Without this the
// last lane iteration of every slice runs mostly empty (e.g. 256 bins over 7
// slices -> 37 bins = 32 + 5 active lanes), and the fold would pay that waste
// once per slice instead of once per feature. Widening can only reduce the
// number of slices a feature uses, so `used <= BatchSlices(count)` holds.
__simt_callee__ inline uint64_t BatchSliceWidth(uint64_t bins,uint32_t slices) {
  uint64_t width=(bins+slices-1U)/slices;
  return ((width+kBatchLanes-1U)/kBatchLanes)*kBatchLanes;
}
__simt_callee__ inline __gm__ ne::NodeBatchFeature const* BatchFeatures(
    __gm__ ne::NodeBatchHeader const* header) {
  return reinterpret_cast<__gm__ ne::NodeBatchFeature const*>(header+1);
}
__simt_callee__ inline ne::Parameters BatchParameters(__gm__ ne::NodeBatchHeader const* header) {
  auto const& p=header->parameters;
  return {p.min_child_weight,p.reg_lambda,p.reg_alpha,p.max_delta_step,p.gradient_scale,p.hessian_scale};
}
// Inclusive scan across the 32 lanes of one warp. Every value scanned below is
// a sum of a disjoint subset of one histogram, and the validated histogram
// bounds each sign's partial sums by int64, so the tree order is exact integer
// arithmetic and therefore bit-identical to the sequential running sum.
__simt_callee__ inline int64_t BatchWarpScan(int64_t value,uint32_t lane) {
  int64_t total=value;
  #pragma unroll
  for (uint32_t delta=1;delta<kBatchLanes;delta<<=1) {
    int64_t other=asc_shfl_up(total,delta);
    if (lane>=delta) total+=other;
  }
  return total;
}
__simt_callee__ inline uint32_t BatchWarpOr(uint32_t value) {
  uint32_t total=value;
  #pragma unroll
  for (uint32_t delta=kBatchLanes/2;delta>0;delta>>=1) total|=asc_shfl_xor(total,static_cast<int32_t>(delta));
  return total;
}
// The total order every reducer in this file uses, and the one the pinned
// scalar folds implement: larger gain wins; GreaterGain treats the two signed
// zeros as equal, so equal gains fall through to the smaller position key. A
// 64-bit key keeps one comparison for both the intra-chunk candidate index and
// Finish's (position%256, position/256) CUB stripe order.
__simt_callee__ inline bool BatchBetter(uint32_t gain,uint64_t key,uint32_t best_gain,uint64_t best_key) {
  if (ne::GreaterGain(gain,best_gain)) return true;
  if (ne::GreaterGain(best_gain,gain)) return false;
  return key<best_key;
}
__simt_callee__ inline void BatchWarpArgMax(uint32_t& gain,uint64_t& key) {
  #pragma unroll
  for (uint32_t delta=kBatchLanes/2;delta>0;delta>>=1) {
    uint32_t other_gain=asc_shfl_xor(gain,static_cast<int32_t>(delta));
    uint64_t other_key=asc_shfl_xor(key,static_cast<int32_t>(delta));
    if (BatchBetter(other_gain,other_key,gain,key)) { gain=other_gain;key=other_key; }
  }
}
// Finish's stripe key: thread = position%256, iteration = position/256.
__simt_callee__ inline uint64_t BatchStripeKey(uint64_t feature) {
  return (feature&255U)<<32U|(feature>>8U);
}
__simt_callee__ inline uint64_t BatchStripeFeature(uint64_t key) {
  return (key>>32U)+256U*(key&0xffffffffU);
}
__simt_vf__ __aicore__ LAUNCH_BOUND(kBatchThreads) inline void BatchedSplitPrefixVf(
    __gm__ ne::NodeBatchHeader const* header,__gm__ int64_t* pg,__gm__ int64_t* ph,
    __gm__ uint32_t* ready,uint32_t block,uint32_t blocks) {
  // One warp owns a feature, hence exactly one writer per prefix entry.
  if (block >= blocks) return;
  uint64_t count=header->feature_count;
  uint64_t warps=static_cast<uint64_t>(blocks)*kBatchWarpsPerBlock;
  if (!warps) return;
  uint32_t lane=static_cast<uint32_t>(threadIdx.x)&(kBatchLanes-1U);
  uint32_t warp=static_cast<uint32_t>(threadIdx.x)>>5U;
  auto features=BatchFeatures(header);
  for (uint64_t f=static_cast<uint64_t>(block)*kBatchWarpsPerBlock+warp;f<count;f+=warps) {
    auto const& d=features[f];
    auto g=reinterpret_cast<__gm__ int64_t const*>(d.gradient_address);
    auto h=reinterpret_cast<__gm__ int64_t const*>(d.hessian_address);
    uint64_t bins=d.bin_count,base=d.prefix_offset;
    int64_t carry_g=0,carry_h=0;
    // Strided lane -> bin map keeps the two loads and the two stores of a round
    // warp-coalesced, and the round's scan covers the whole candidate set in
    // bin_count/32 steps with no second pass over the histogram.
    for (uint64_t k=0;k<bins;k+=kBatchLanes) {
      uint64_t i=k+lane;
      int64_t vg=(i<bins)?g[i]:0;
      int64_t vh=(i<bins)?h[i]:0;
      int64_t ig=BatchWarpScan(vg,lane);
      int64_t ih=BatchWarpScan(vh,lane);
      int64_t round_g=asc_shfl(ig,static_cast<int32_t>(kBatchLanes-1U));
      int64_t round_h=asc_shfl(ih,static_cast<int32_t>(kBatchLanes-1U));
      if (i<bins) { pg[base+i]=carry_g+(ig-vg);ph[base+i]=carry_h+(ih-vh); }
      carry_g+=round_g;carry_h+=round_h;
    }
    if (!lane) { pg[base+bins]=carry_g;ph[base+bins]=carry_h;ready[f]=1; }
  }
}
__simt_vf__ __aicore__ LAUNCH_BOUND(kBatchScoreThreads) inline void BatchedSplitScoreVf(
    __gm__ ne::NodeBatchHeader const* header,__gm__ int64_t const* root_g,
    __gm__ int64_t const* root_h,__gm__ int64_t const* pg,__gm__ int64_t const* ph,
    __gm__ uint32_t const* prefix_ready,__gm__ ne::DirectionOutput* scores,
    __gm__ uint32_t* ready,uint32_t block,uint32_t blocks) {
  if (block >= blocks) return;
  uint64_t count=header->feature_count;
  uint64_t warps=static_cast<uint64_t>(blocks)*kBatchScoreWarpsPerBlock;
  if (!count || !warps) return;
  auto features=BatchFeatures(header);
  // Parameter decoding and the two root quantities are loop invariant; hoisting
  // them removes one binary64 parameter decode per candidate.
  auto prepared=ne::Prepare(BatchParameters(header));
  int64_t root_gradient=*root_g,root_hessian=*root_h;
  uint32_t lane=static_cast<uint32_t>(threadIdx.x)&(kBatchLanes-1U);
  uint32_t warp=static_cast<uint32_t>(threadIdx.x)>>5U;
  // One warp owns one (feature, contiguous bin slice). The slice argmax stays
  // inside the warp, so Score publishes a per-slice partial candidate instead of
  // a per-candidate record: that removes six of the nine global accesses this
  // stage used to spend per candidate and leaves the winner reduction to the
  // tiny consumer below. Splitting the bins also means a wide-histogram feature
  // (few features, many bins) still fills every warp.
  uint32_t slices=BatchSlices(count);
  uint64_t units=count*slices;
  // Partition the unit range per block (one block per vector core) instead of
  // per warp. A block runs several warps on one core, so the core's load is the
  // sum over its warps; interleaving units across the whole grid makes that sum
  // depend on the residuum of `blocks*kBatchWarpsPerBlock` modulo `slices`, and
  // when the two share a factor every warp of a block lands on the same slice
  // index. With heterogeneous bin counts that hands some cores only empty
  // slices while their neighbours carry all the candidates. A balanced
  // contiguous run per block removes both the aliasing and the residue: the run
  // sizes differ by at most one, and the block's warps interleave inside it.
  uint64_t per_block=units/blocks;
  uint64_t spare=units%blocks;
  uint64_t my_begin=static_cast<uint64_t>(block)*per_block+
      ((block<spare)?static_cast<uint64_t>(block):spare);
  uint64_t my_count=per_block+((block<spare)?1U:0U);
  uint64_t my_end=my_begin+my_count;
  for (uint64_t unit=my_begin+warp;unit<my_end;unit+=kBatchScoreWarpsPerBlock) {
    uint64_t f=unit/slices;
    uint32_t slice=static_cast<uint32_t>(unit-f*slices);
    auto const& d=features[f];
    uint64_t bins=d.bin_count;
    uint64_t width=BatchSliceWidth(bins,slices);
    uint64_t begin=static_cast<uint64_t>(slice)*width;
    if (!width || begin>=bins) continue;   // this slice contributes no candidate
    uint64_t last=(begin+width<bins)?begin+width:bins;
    uint32_t gain=0xff800000U,left_weight=0,right_weight=0,score_error=0,missing_left=0;
    uint64_t key=static_cast<uint64_t>(UINT32_MAX);
    uint32_t lane_errors=0;
    if (prefix_ready[f]!=1) {
      lane_errors=ne::kBatchIncomplete;
    } else {
      auto end=d.prefix_offset+bins;
      int64_t total_g=pg[end],total_h=ph[end];
      int64_t missing_g=root_gradient-total_g,missing_h=root_hessian-total_h;
      for (uint64_t i=begin+lane;i<last;i+=kBatchLanes) {
        auto offset=d.prefix_offset+i;
        int64_t lg=pg[offset],lh=ph[offset];
        // Candidate BEFORE bin i. No candidate is produced after the last bin.
        auto left=ne::EvaluatePrepared(lg+missing_g,lh+missing_h,total_g-lg,total_h-lh,prepared);
        auto right=ne::EvaluatePrepared(lg,lh,root_gradient-lg,root_hessian-lh,prepared);
        auto value=ne::ChooseDirection(left,right);
        lane_errors|=value.error;
        // Same gate as UpdateCandidate's `right.valid`: an invalid direction
        // (gain == -inf sentinel) never enters the fold, so a feature with no
        // admissible candidate still resolves to the empty sentinel.
        if (value.score.gain!=0xff800000U &&
            BatchBetter(value.score.gain,static_cast<uint64_t>(i),gain,key)) {
          gain=value.score.gain;key=static_cast<uint64_t>(i);
          left_weight=value.score.left_weight;right_weight=value.score.right_weight;
          score_error=value.score.error;missing_left=value.missing_left;
        }
      }
    }
    // Slice result: reduce the per-lane winners, then pull the winner's payload
    // from the lane that produced it (bin i lives in lane (i-begin)%32).
    BatchWarpArgMax(gain,key);
    uint32_t slice_errors=BatchWarpOr(lane_errors);
    if (key!=static_cast<uint64_t>(UINT32_MAX)) {
      uint32_t source=static_cast<uint32_t>((key-begin)&(kBatchLanes-1U));
      left_weight=asc_shfl(left_weight,static_cast<int32_t>(source));
      right_weight=asc_shfl(right_weight,static_cast<int32_t>(source));
      score_error=asc_shfl(score_error,static_cast<int32_t>(source));
      missing_left=asc_shfl(missing_left,static_cast<int32_t>(source));
    }
    if (!lane) {
      // A slice with no promotable candidate still publishes its slot with the
      // invalid sentinel, so the consumer sees the slice was scored.
      uint32_t slot=static_cast<uint32_t>(d.candidate_offset+slice);
      scores[slot].score.left_weight=(key==static_cast<uint64_t>(UINT32_MAX))?0U:left_weight;
      scores[slot].score.right_weight=(key==static_cast<uint64_t>(UINT32_MAX))?0U:right_weight;
      scores[slot].score.gain=gain;
      scores[slot].score.error=(key==static_cast<uint64_t>(UINT32_MAX))?0U:score_error;
      scores[slot].missing_left=((key==static_cast<uint64_t>(UINT32_MAX))?0U:missing_left)
          |(slice_errors<<kBatchPartialShift);
      scores[slot].error=(key==static_cast<uint64_t>(UINT32_MAX))?UINT32_MAX
          :static_cast<uint32_t>(key);
      ready[slot]=1;
    }
  }
}
__simt_vf__ __aicore__ LAUNCH_BOUND(kBatchThreads) inline void BatchedSplitSelectVf(
    __gm__ ne::NodeBatchHeader const* header,__gm__ uint32_t const* prefix_ready,
    __gm__ ne::DirectionOutput const* scores,__gm__ uint32_t const* score_ready,
    __gm__ ne::Candidate* selected,__gm__ uint32_t* ready,uint32_t block,uint32_t blocks) {
  // One warp owns a feature and reduces one partial candidate per bin slice.
  // The pinned fold is a total order - larger gain first, ties by the smaller
  // candidate index - so folding the slice winners in the same order reproduces
  // the per-candidate CUB result exactly, while reading S(=<=32) records instead
  // of reading one record per bin.
  if (block >= blocks) return;
  uint64_t count=header->feature_count;
  uint64_t warps=static_cast<uint64_t>(blocks)*kBatchWarpsPerBlock;
  if (!warps) return;
  uint32_t lane=static_cast<uint32_t>(threadIdx.x)&(kBatchLanes-1U);
  uint32_t warp=static_cast<uint32_t>(threadIdx.x)>>5U;
  auto features=BatchFeatures(header);
  uint32_t slices=BatchSlices(count);
  for (uint64_t f=static_cast<uint64_t>(block)*kBatchWarpsPerBlock+warp;f<count;f+=warps) {
    auto const& d=features[f];
    uint64_t bins=d.bin_count;
    uint64_t width=BatchSliceWidth(bins,slices);
    uint64_t used=width?(bins+width-1U)/width:0U;   // slices that hold a candidate
    uint32_t gain=0xff800000U,left_weight=0,right_weight=0,score_error=0,missing_left=0;
    uint64_t key=static_cast<uint64_t>(UINT32_MAX);
    uint32_t lane_errors=prefix_ready[f]==1?0U:ne::kBatchIncomplete;
    if (lane<used) {
      uint32_t slot=static_cast<uint32_t>(d.candidate_offset+lane);
      if (score_ready[slot]!=1) {
        lane_errors|=ne::kBatchIncomplete;
      } else {
        auto const& v=scores[slot];
        uint32_t witness=v.missing_left;
        lane_errors|=witness>>kBatchPartialShift;
        // word4 of a Score partial is the winning bin index, or UINT32_MAX when
        // that slice held no admissible candidate.
        uint32_t candidate=v.error;
        if (candidate!=UINT32_MAX && v.score.gain!=0xff800000U) {
          gain=v.score.gain;key=static_cast<uint64_t>(candidate);
          left_weight=v.score.left_weight;right_weight=v.score.right_weight;
          score_error=v.score.error;missing_left=witness&0xffU;
        }
      }
    }
    BatchWarpArgMax(gain,key);
    auto best=ne::EmptyCandidate();
    if (key!=static_cast<uint64_t>(UINT32_MAX)) {
      uint32_t source=static_cast<uint32_t>((key/width)&(kBatchLanes-1U));
      best.score.left_weight=asc_shfl(left_weight,static_cast<int32_t>(source));
      best.score.right_weight=asc_shfl(right_weight,static_cast<int32_t>(source));
      best.score.gain=gain;
      best.score.error=asc_shfl(score_error,static_cast<int32_t>(source));
      best.feature=d.feature;best.candidate=static_cast<uint32_t>(key);
      best.missing_left=asc_shfl(missing_left,static_cast<int32_t>(source));
      best.valid=1;best.padding=0;
    }
    best.error|=BatchWarpOr(lane_errors);
    // A zero-bin / all-invalid feature explicitly publishes EmptyCandidate.
    if (!lane) { ne::StoreCandidate(selected+f,best);ready[f]=1; }
  }
}
__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void BatchedSplitFinishVf(
    __gm__ ne::NodeBatchHeader const* header,__gm__ int64_t const* root_g,
    __gm__ int64_t const* root_h,__gm__ int64_t const* pg,__gm__ int64_t const* ph,
    __gm__ uint32_t const* prefix_ready,__gm__ ne::Candidate const* selected,
    __gm__ uint32_t const* selected_ready,__gm__ ne::SplitSummary* s,
    uint32_t block,uint32_t blocks) {
  // A single summary: one warp reduces the per-feature candidates, lane 0
  // publishes. The pinned scan visits feature `position` at thread
  // position%256, iteration position/256, so a (position%256, position/256)
  // key reproduces its tie order without 256 serial steps.
  if (block >= blocks) return;
  if (static_cast<uint32_t>(threadIdx.x)>=kBatchLanes) return;
  uint32_t lane=static_cast<uint32_t>(threadIdx.x);
  auto p=BatchParameters(header);
  auto node=ne::NodeQuantities(*root_g,*root_h,p);
  uint64_t count=header->feature_count;
  auto features=BatchFeatures(header);
  uint64_t rounds=(count+kBatchLanes-1U)/kBatchLanes;
  uint32_t gain=0xff800000U;uint64_t key=~static_cast<uint64_t>(0);
  uint32_t lane_errors=0;
  for (uint64_t k=0;k<rounds;++k) {
    uint64_t f=k*kBatchLanes+lane;
    if (f>=count) continue;
    uint32_t candidate_gain=0xff800000U;
    uint64_t candidate_key=~static_cast<uint64_t>(0);
    if (selected_ready[f]!=1 || prefix_ready[f]!=1) {
      lane_errors|=ne::kBatchIncomplete;
    } else {
      auto c=ne::LoadCandidate(selected+f);
      lane_errors|=c.error;
      if (c.valid) { candidate_gain=c.score.gain;candidate_key=BatchStripeKey(f); }
    }
    if (BatchBetter(candidate_gain,candidate_key,gain,key)) { gain=candidate_gain;key=candidate_key; }
  }
  BatchWarpArgMax(gain,key);
  uint32_t errors=node.error|BatchWarpOr(lane_errors);
  int64_t left_g=0,left_h=0,right_g=0,right_h=0;
  auto best=ne::EmptyCandidate();
  if (!lane) {
    if (key!=~static_cast<uint64_t>(0)) {
      uint32_t f=static_cast<uint32_t>(BatchStripeFeature(key));
      auto c=ne::LoadCandidate(selected+f);
      auto const& d=features[f];
      if (c.feature!=d.feature || c.candidate>=d.bin_count || c.missing_left>1) {
        errors|=2;
      } else {
        best=c;auto offset=d.prefix_offset+c.candidate;auto end=d.prefix_offset+d.bin_count;
        int64_t lg=pg[offset],lh=ph[offset],tg=pg[end],th=ph[end];
        left_g=c.missing_left?lg+(*root_g-tg):lg;
        left_h=c.missing_left?lh+(*root_h-th):lh;
        right_g=c.missing_left?tg-lg:*root_g-lg;
        right_h=c.missing_left?th-lh:*root_h-lh;
      }
    }
    auto gain_out=ne::SubtractParent(best.score.gain,node.gain);errors|=gain_out.error;
    ne::StoreCandidate(&s->best,best);
    s->node.weight=node.weight;s->node.gain=node.gain;s->node.error=node.error;s->node.padding=0;
    s->gradient=*root_g;s->hessian=*root_h;
    s->left_gradient=left_g;s->left_hessian=left_h;s->right_gradient=right_g;s->right_hessian=right_h;
    s->loss_change=gain_out.loss_change;s->error=errors;
  }
}
extern "C" __global__ __aicore__ void BatchedSplitPrefixKernel(
    GM_ADDR metadata,GM_ADDR pg,GM_ADDR ph,GM_ADDR ready) {
  asc_vf_call<BatchedSplitPrefixVf>(dim3(kBatchThreads),reinterpret_cast<__gm__ ne::NodeBatchHeader const*>(metadata),
    reinterpret_cast<__gm__ int64_t*>(pg),reinterpret_cast<__gm__ int64_t*>(ph),
    reinterpret_cast<__gm__ uint32_t*>(ready),AscendC::GetBlockIdx(),AscendC::GetBlockNum());
}
extern "C" __global__ __aicore__ void BatchedSplitScoreKernel(
    GM_ADDR metadata,GM_ADDR g,GM_ADDR h,GM_ADDR pg,GM_ADDR ph,GM_ADDR prefix_ready,
    GM_ADDR scores,GM_ADDR ready) {
  asc_vf_call<BatchedSplitScoreVf>(dim3(kBatchScoreThreads),reinterpret_cast<__gm__ ne::NodeBatchHeader const*>(metadata),
    reinterpret_cast<__gm__ int64_t const*>(g),reinterpret_cast<__gm__ int64_t const*>(h),
    reinterpret_cast<__gm__ int64_t const*>(pg),reinterpret_cast<__gm__ int64_t const*>(ph),
    reinterpret_cast<__gm__ uint32_t const*>(prefix_ready),reinterpret_cast<__gm__ ne::DirectionOutput*>(scores),
    reinterpret_cast<__gm__ uint32_t*>(ready),AscendC::GetBlockIdx(),AscendC::GetBlockNum());
}
extern "C" __global__ __aicore__ void BatchedSplitSelectKernel(
    GM_ADDR metadata,GM_ADDR prefix_ready,GM_ADDR scores,GM_ADDR score_ready,
    GM_ADDR selected,GM_ADDR ready) {
  asc_vf_call<BatchedSplitSelectVf>(dim3(kBatchThreads),reinterpret_cast<__gm__ ne::NodeBatchHeader const*>(metadata),
    reinterpret_cast<__gm__ uint32_t const*>(prefix_ready),reinterpret_cast<__gm__ ne::DirectionOutput const*>(scores),
    reinterpret_cast<__gm__ uint32_t const*>(score_ready),reinterpret_cast<__gm__ ne::Candidate*>(selected),
    reinterpret_cast<__gm__ uint32_t*>(ready),AscendC::GetBlockIdx(),AscendC::GetBlockNum());
}
extern "C" __global__ __aicore__ void BatchedSplitFinishKernel(
    GM_ADDR metadata,GM_ADDR g,GM_ADDR h,GM_ADDR pg,GM_ADDR ph,GM_ADDR prefix_ready,
    GM_ADDR selected,GM_ADDR selected_ready,GM_ADDR summary) {
  asc_vf_call<BatchedSplitFinishVf>(dim3(128),reinterpret_cast<__gm__ ne::NodeBatchHeader const*>(metadata),
    reinterpret_cast<__gm__ int64_t const*>(g),reinterpret_cast<__gm__ int64_t const*>(h),
    reinterpret_cast<__gm__ int64_t const*>(pg),reinterpret_cast<__gm__ int64_t const*>(ph),
    reinterpret_cast<__gm__ uint32_t const*>(prefix_ready),reinterpret_cast<__gm__ ne::Candidate const*>(selected),
    reinterpret_cast<__gm__ uint32_t const*>(selected_ready),reinterpret_cast<__gm__ ne::SplitSummary*>(summary),
    AscendC::GetBlockIdx(),AscendC::GetBlockNum());
}
#define XGB_NPU_BATCH_ADDR(pointer) reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(pointer))
extern "C" void XgbNpuBatchedSplitPrefix(void* stream,void const* metadata,
    void* pg,void* ph,void* prefix_status,uint32_t count) {
  // One warp per feature instead of one block per feature.
  uint32_t blocks=count?(count+kBatchWarpsPerBlock-1U)/kBatchWarpsPerBlock:1;
  if (blocks>kBatchMaxWarpBlocks) blocks=kBatchMaxWarpBlocks;
  BatchedSplitPrefixKernel<<<blocks,nullptr,stream>>>(XGB_NPU_BATCH_ADDR(metadata),
    XGB_NPU_BATCH_ADDR(pg),XGB_NPU_BATCH_ADDR(ph),XGB_NPU_BATCH_ADDR(prefix_status));
}
extern "C" void XgbNpuBatchedSplitScore(void* stream,void const* metadata,
    void const* g,void const* h,void const* pg,void const* ph,void const* prefix_status,
    void* scores,void* score_status,uint32_t count) {
  // Grid: one block per vector core, but only once a core has enough units to
  // pay for itself. Both limits are measured. Deriving the grid from the warp
  // count instead under-fills the machine on narrow launches (8 features x 32
  // slices is 256 units, which is only 16 blocks of 16 warps), while spreading
  // the same 256 units over all 64 cores leaves four units per core and loses
  // more to per-block setup than the extra cores win back. Eight units per core
  // is the point where widening stops paying.
  constexpr uint32_t kUnitsPerBlock=8U;
  uint32_t blocks=1;
  if (count) {
    uint64_t units=static_cast<uint64_t>(count)*BatchHostSlices(count);
    uint64_t want=(units+kUnitsPerBlock-1U)/kUnitsPerBlock;
    blocks=want>(kBatchMaxScoreBlocks)?kBatchMaxScoreBlocks:static_cast<uint32_t>(want);
    if (!blocks) blocks=1;
  }
  BatchedSplitScoreKernel<<<blocks,nullptr,stream>>>(XGB_NPU_BATCH_ADDR(metadata),
    XGB_NPU_BATCH_ADDR(g),XGB_NPU_BATCH_ADDR(h),XGB_NPU_BATCH_ADDR(pg),XGB_NPU_BATCH_ADDR(ph),
    XGB_NPU_BATCH_ADDR(prefix_status),XGB_NPU_BATCH_ADDR(scores),XGB_NPU_BATCH_ADDR(score_status));
}
extern "C" void XgbNpuBatchedSplitSelect(void* stream,void const* metadata,
    void const* prefix_status,void const* scores,void const* score_status,
    void* selected,void* selected_status,uint32_t count) {
  uint32_t blocks=count?(count+kBatchWarpsPerBlock-1U)/kBatchWarpsPerBlock:1;
  if (blocks>kBatchMaxWarpBlocks) blocks=kBatchMaxWarpBlocks;
  BatchedSplitSelectKernel<<<blocks,nullptr,stream>>>(XGB_NPU_BATCH_ADDR(metadata),
    XGB_NPU_BATCH_ADDR(prefix_status),XGB_NPU_BATCH_ADDR(scores),XGB_NPU_BATCH_ADDR(score_status),
    XGB_NPU_BATCH_ADDR(selected),XGB_NPU_BATCH_ADDR(selected_status));
}
extern "C" void XgbNpuBatchedSplitFinish(void* stream,void const* metadata,
    void const* g,void const* h,void const* pg,void const* ph,void const* prefix_status,
    void const* selected,void const* selected_status,void* summary) {
  BatchedSplitFinishKernel<<<1,nullptr,stream>>>(XGB_NPU_BATCH_ADDR(metadata),
    XGB_NPU_BATCH_ADDR(g),XGB_NPU_BATCH_ADDR(h),XGB_NPU_BATCH_ADDR(pg),XGB_NPU_BATCH_ADDR(ph),
    XGB_NPU_BATCH_ADDR(prefix_status),XGB_NPU_BATCH_ADDR(selected),XGB_NPU_BATCH_ADDR(selected_status),XGB_NPU_BATCH_ADDR(summary));
}
#undef XGB_NPU_BATCH_ADDR
