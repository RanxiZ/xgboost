#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#define XGB_NPU_PRECISE_INLINE __aicore__ inline
#include "split_finalization.h"
namespace sf=xgboost::common::npu::precise;
__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void NodeQuantitiesVf(
    __gm__ sf::NodeInput const* input,__gm__ sf::NodeOutput* output,uint32_t n,uint32_t block,uint32_t blocks) {
  for (uint64_t i=static_cast<uint64_t>(block)*128+threadIdx.x;i<n;i+=static_cast<uint64_t>(blocks)*128) {
    auto const& v=input[i];
    sf::Parameters p{v.parameters.min_child_weight,v.parameters.reg_lambda,v.parameters.reg_alpha,
                     v.parameters.max_delta_step,v.parameters.gradient_scale,v.parameters.hessian_scale};
    auto out=sf::NodeQuantities(v.gradient,v.hessian,p);
    output[i].weight=out.weight; output[i].gain=out.gain; output[i].error=out.error; output[i].padding=0;
  }
}
__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void ChooseDirectionVf(
    __gm__ sf::Score const* left,__gm__ sf::Score const* right,__gm__ sf::DirectionOutput* output,
    uint32_t n,uint32_t block,uint32_t blocks) {
  for (uint64_t i=static_cast<uint64_t>(block)*128+threadIdx.x;i<n;i+=static_cast<uint64_t>(blocks)*128) {
    sf::Score l{left[i].left_weight,left[i].right_weight,left[i].gain,left[i].error};
    sf::Score r{right[i].left_weight,right[i].right_weight,right[i].gain,right[i].error};
    auto out=sf::ChooseDirection(l,r);
    output[i].score.left_weight=out.score.left_weight; output[i].score.right_weight=out.score.right_weight;
    output[i].score.gain=out.score.gain; output[i].score.error=out.score.error;
    output[i].missing_left=out.missing_left; output[i].error=out.error;
  }
}
__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void SubtractParentVf(
    __gm__ sf::GainInput const* input,__gm__ sf::GainOutput* output,uint32_t n,uint32_t block,uint32_t blocks) {
  for (uint64_t i=static_cast<uint64_t>(block)*128+threadIdx.x;i<n;i+=static_cast<uint64_t>(blocks)*128) {
    auto out=sf::SubtractParent(input[i].selected_child_gain,input[i].parent_gain);
    output[i].loss_change=out.loss_change; output[i].error=out.error;
  }
}
extern "C" __global__ __aicore__ void NodeQuantitiesKernel(GM_ADDR input,GM_ADDR output,uint32_t n) {
  asc_vf_call<NodeQuantitiesVf>(dim3(128),reinterpret_cast<__gm__ sf::NodeInput const*>(input),
    reinterpret_cast<__gm__ sf::NodeOutput*>(output),n,AscendC::GetBlockIdx(),AscendC::GetBlockNum());
}
extern "C" __global__ __aicore__ void ChooseDirectionKernel(GM_ADDR left,GM_ADDR right,GM_ADDR output,uint32_t n) {
  asc_vf_call<ChooseDirectionVf>(dim3(128),reinterpret_cast<__gm__ sf::Score const*>(left),
    reinterpret_cast<__gm__ sf::Score const*>(right),reinterpret_cast<__gm__ sf::DirectionOutput*>(output),
    n,AscendC::GetBlockIdx(),AscendC::GetBlockNum());
}
extern "C" __global__ __aicore__ void SubtractParentKernel(GM_ADDR input,GM_ADDR output,uint32_t n) {
  asc_vf_call<SubtractParentVf>(dim3(128),reinterpret_cast<__gm__ sf::GainInput const*>(input),
    reinterpret_cast<__gm__ sf::GainOutput*>(output),n,AscendC::GetBlockIdx(),AscendC::GetBlockNum());
}
extern "C" void XgbNpuNodeQuantities(void* stream,void const* input,void* output,uint32_t count) {
  if (!count) return;
  uint32_t blocks=(count-1)/128+1; if (blocks>16) blocks=16;
  NodeQuantitiesKernel<<<blocks,nullptr,stream>>>(reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(input)),
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(output)),count);
}

extern "C" void XgbNpuChooseDirection(void* stream,void const* left,void const* right,void* output,uint32_t count) {
  if (!count) return;
  uint32_t blocks=(count-1)/128+1; if (blocks>16) blocks=16;
  ChooseDirectionKernel<<<blocks,nullptr,stream>>>(reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(left)),
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(right)),
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(output)),count);
}

extern "C" void XgbNpuSubtractParent(void* stream,void const* input,void* output,uint32_t count) {
  if (!count) return;
  uint32_t blocks=(count-1)/128+1; if (blocks>16) blocks=16;
  SubtractParentKernel<<<blocks,nullptr,stream>>>(reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(input)),
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(output)),count);
}
