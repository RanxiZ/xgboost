// Four-feature tiled UB histogram with GM-resident carries (three-row unroll).
//
// DAV-3510 SIMT facts this design rests on (world_model probe notes):
//   * one VF may only touch ~8KB of dynamically indexed UB (507015 beyond it);
//   * UB int64 atomics do not exist, but int32 UB atomics do and UB atomics
//     are immune to the bin skew that destroys GM int64 atomics;
//   * a 64-bit counter can be kept as (hi in GM, signed int32 lo in UB) where
//     hi is bumped only on low-word overflow (~2^31/|val| updates per bin).
//
// Variant: the row loop is unrolled by two so two independent gather chains
// are in flight. Keeping only the 2KB low-word histogram per feature in UB lets a tile hold
// four features (8KB), so a 158-feature block needs 2 row passes instead of 3.
// The high word lives in the output buffer itself: blocks own their feature
// range, the output is zeroed before the row loop, and each overflow issues a
// single int32 GM atomic into the high half of the int64 output cell. The final
// write-out folds hi<<32 + lo into the exact int64 result.
//
// Fallback: blocks whose max bin count exceeds 256 use the proven GM int64
// atomic VF (device tests exercise 257/513/1025/2049 bins).
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "simt_api/cpp/kernel_simt_intf.h"
#include "integer_histogram_abi.h"

namespace ih = xgboost::common::npu::histogram;

namespace {
constexpr uint32_t kLargeBlocks = 32;
constexpr uint32_t kSmallBlocks = 32;
constexpr uint32_t kLargeThreads = 1024;
constexpr uint32_t kSmallThreads = 512;
constexpr uint64_t kSmallRows = 4096;
constexpr uint32_t kUbMaxBins = 256;
// Low words only: 256 bins x {gradient, hessian} int32 = 2KB per feature.
constexpr uint32_t kUbInt32PerFeature = 2 * kUbMaxBins;
constexpr uint32_t kTile = 4;
constexpr uint32_t kUbTileCounters = kTile * kUbInt32PerFeature;

__SIMT_DEVICE_FUNCTIONS_DECL__ inline __ubuf__ int32_t* UbLo(
    __ubuf__ int32_t* hist, uint32_t quantity, uint32_t bin) {
  return hist + quantity * kUbMaxBins + bin;
}

// High half of the int64 output cell (little endian): the high word lives there.
__SIMT_DEVICE_FUNCTIONS_DECL__ inline __gm__ int32_t* GmHi(__gm__ int64_t* out, uint32_t bin) {
  return reinterpret_cast<__gm__ int32_t*>(out + bin) + 1;
}

// Counter representation: value == (int64)hi * 2^32 + (uint32)lo, where lo is
// the unsigned low word kept in UB and hi is the signed high word kept in GM.
// Every update must add the value's own high word plus the unsigned carry of
// the low-word addition; carrying only on signed low-word overflow (the round-3
// scheme) silently drops all high bits of |val| >= 2^32, which the CUDA-derived
// fixture and the real quantized gradients both exercise.
__SIMT_DEVICE_FUNCTIONS_DECL__ inline void UbAccumulateTiled(
    __ubuf__ int32_t* lo_hist, __gm__ int64_t* gm_out, uint32_t quantity,
    uint32_t bin, int64_t val) {
  uint64_t uval = static_cast<uint64_t>(val);
  int32_t lo_word = static_cast<int32_t>(static_cast<uint32_t>(uval));
  int32_t hi_word = static_cast<int32_t>(static_cast<uint32_t>(uval >> 32));
  int32_t old_lo = AscendC::Simt::AtomicAdd(UbLo(lo_hist, quantity, bin), lo_word);
  uint32_t sum = static_cast<uint32_t>(old_lo) + static_cast<uint32_t>(lo_word);
  int32_t carry = sum < static_cast<uint32_t>(old_lo) ? 1 : 0;
  int32_t hi_delta = hi_word + carry;
  if (hi_delta != 0) {
    AscendC::Simt::AtomicAdd(GmHi(gm_out, bin), hi_delta);
  }
}

template <uint32_t kThreads>
__simt_vf__ __aicore__ LAUNCH_BOUND(kThreads) inline void IntegerHistogramUbTileVf(
    __gm__ int64_t const* row_ids, __gm__ int64_t const* gradient,
    __gm__ int64_t const* hessian, __gm__ ih::FeatureDescriptor const* metadata,
    uint64_t row_count, uint32_t slot_count, uint64_t ub_addr) {
  // DAV-3510: UB pointers cannot be passed directly through asc_vf_call;
  // marshal the physical UB address as uint64_t and cast inside the VF.
  __ubuf__ int32_t* hist = reinterpret_cast<__ubuf__ int32_t*>(ub_addr);

  for (uint32_t base = 0; base < slot_count; base += kTile) {
    uint32_t n = slot_count - base < kTile ? slot_count - base : kTile;
    __gm__ int64_t const* columns[kTile];
    __gm__ int64_t* out_g[kTile];
    __gm__ int64_t* out_h[kTile];
    uint32_t bins_arr[kTile];
#pragma unroll
    for (uint32_t t = 0; t < kTile; ++t) {
      if (t < n) {
        columns[t] = reinterpret_cast<__gm__ int64_t const*>(metadata[base + t].input_column);
        out_g[t] = reinterpret_cast<__gm__ int64_t*>(metadata[base + t].output_gradient);
        out_h[t] = reinterpret_cast<__gm__ int64_t*>(metadata[base + t].output_hessian);
        bins_arr[t] = metadata[base + t].bins;
      } else {
        columns[t] = nullptr;
        out_g[t] = nullptr;
        out_h[t] = nullptr;
        bins_arr[t] = 0;
      }
    }
    // Clear the low words before the row loop; the output buffers are cleared
    // here as well so their high halves can serve as carry counters.
#pragma unroll
    for (uint32_t t = 0; t < kTile; ++t) {
      if (t < n) {
        __ubuf__ int32_t* slice = hist + t * kUbInt32PerFeature;
        for (uint32_t i = threadIdx.x; i < kUbInt32PerFeature; i += kThreads) {
          slice[i] = 0;
        }
        uint32_t bins = bins_arr[t];
        uint64_t output_bins = bins == 0 ? 1 : bins;
        for (uint64_t b = threadIdx.x; b < output_bins; b += kThreads) {
          out_g[t][b] = 0;
          out_h[t][b] = 0;
        }
      }
    }
    AscendC::Simt::ThreadFence();
    AscendC::Simt::ThreadBarrier();
    // Three rows per iteration.
    constexpr uint64_t kStride = 3u * kThreads;
    for (uint64_t pos = threadIdx.x; pos < row_count; pos += kStride) {
      int64_t rows[3];
      int64_t gs[3];
      int64_t hs[3];
      bool live[3];
#pragma unroll
      for (uint32_t u = 0; u < 3; ++u) {
        uint64_t p = pos + u * static_cast<uint64_t>(kThreads);
        live[u] = p < row_count;
        rows[u] = live[u] ? row_ids[p] : row_ids[pos];
        gs[u] = live[u] ? gradient[rows[u]] : 0;
        hs[u] = live[u] ? hessian[rows[u]] : 0;
      }
#pragma unroll
      for (uint32_t t = 0; t < kTile; ++t) {
        if (t < n) {
          uint32_t bins = bins_arr[t];
          if (bins != 0) {
            __ubuf__ int32_t* slice = hist + t * kUbInt32PerFeature;
#pragma unroll
            for (uint32_t u = 0; u < 3; ++u) {
              if (live[u]) {
                int64_t bin = columns[t][rows[u]];
                if (bin >= 0 && static_cast<uint32_t>(bin) < bins) {
                  UbAccumulateTiled(slice, out_g[t], 0u, static_cast<uint32_t>(bin), gs[u]);
                  UbAccumulateTiled(slice, out_h[t], 1u, static_cast<uint32_t>(bin), hs[u]);
                }
              }
            }
          }
        }
      }
    }
    AscendC::Simt::ThreadFence();
    AscendC::Simt::ThreadBarrier();
#pragma unroll
    for (uint32_t t = 0; t < kTile; ++t) {
      if (t < n) {
        uint32_t bins = bins_arr[t];
        if (bins == 0) {
          if (threadIdx.x == 0) {
            out_g[t][0] = 0;
            out_h[t][0] = 0;
          }
        } else {
          __ubuf__ int32_t* slice = hist + t * kUbInt32PerFeature;
          for (uint32_t b = threadIdx.x; b < bins; b += kThreads) {
            uint64_t lo_g = static_cast<uint32_t>(slice[b]);
            uint64_t lo_h = static_cast<uint32_t>(slice[kUbMaxBins + b]);
            uint32_t hi_g = static_cast<uint32_t>(
                reinterpret_cast<__gm__ int32_t*>(out_g[t] + b)[1]);
            uint32_t hi_h = static_cast<uint32_t>(
                reinterpret_cast<__gm__ int32_t*>(out_h[t] + b)[1]);
            out_g[t][b] = static_cast<int64_t>((static_cast<uint64_t>(hi_g) << 32) | lo_g);
            out_h[t][b] = static_cast<int64_t>((static_cast<uint64_t>(hi_h) << 32) | lo_h);
          }
        }
      }
    }
    AscendC::Simt::ThreadBarrier();
  }
}

// Proven GM int64 atomic fallback for shapes whose bin count exceeds the UB
// budget (device tests exercise 257/513/1025/2049 bins).
template <uint32_t kThreads>
__simt_vf__ __aicore__ LAUNCH_BOUND(kThreads) inline void IntegerHistogramGmAtomicVf(
    __gm__ int64_t const* row_ids, __gm__ int64_t const* gradient,
    __gm__ int64_t const* hessian, __gm__ ih::FeatureDescriptor const* metadata,
    uint64_t row_count, uint32_t slot_count) {
  for (uint32_t slot = 0; slot < slot_count; ++slot) {
    auto const& descriptor = metadata[slot];
    auto out_g = reinterpret_cast<__gm__ int64_t*>(descriptor.output_gradient);
    auto out_h = reinterpret_cast<__gm__ int64_t*>(descriptor.output_hessian);
    uint64_t output_bins = descriptor.bins == 0 ? 1 : descriptor.bins;
    for (uint64_t bin = threadIdx.x; bin < output_bins; bin += kThreads) {
      out_g[bin] = 0;
      out_h[bin] = 0;
    }
    AscendC::Simt::ThreadFence();
    AscendC::Simt::ThreadBarrier();
    if (descriptor.bins != 0) {
      auto column = reinterpret_cast<__gm__ int64_t const*>(descriptor.input_column);
      for (uint64_t position = threadIdx.x; position < row_count; position += kThreads) {
        int64_t row = row_ids[position];
        int64_t bin = column[row];
        if (bin == -1) continue;
        AscendC::Simt::AtomicAdd(out_g + bin, gradient[row]);
        AscendC::Simt::AtomicAdd(out_h + bin, hessian[row]);
      }
    }
    AscendC::Simt::ThreadBarrier();
  }
}
}  // namespace

extern "C" __global__ __aicore__ void IntegerHistogramBuildKernel(
    GM_ADDR row_ids, GM_ADDR gradient, GM_ADDR hessian, GM_ADDR feature_metadata,
    uint64_t row_count, uint64_t feature_count) {
  uint32_t block = AscendC::GetBlockIdx();
  uint32_t blocks = AscendC::GetBlockNum();
  if (block >= blocks || block >= feature_count) return;
  uint32_t feature_begin =
      static_cast<uint32_t>(static_cast<uint64_t>(block) * feature_count / blocks);
  uint32_t feature_end =
      static_cast<uint32_t>(static_cast<uint64_t>(block + 1) * feature_count / blocks);
  uint32_t slot_count = feature_end - feature_begin;
  if (slot_count == 0) return;
  auto rows = reinterpret_cast<__gm__ int64_t const*>(row_ids);
  auto grads = reinterpret_cast<__gm__ int64_t const*>(gradient);
  auto hess = reinterpret_cast<__gm__ int64_t const*>(hessian);
  auto metadata =
      reinterpret_cast<__gm__ ih::FeatureDescriptor const*>(feature_metadata) + feature_begin;
  uint32_t max_bins = 0;
  for (uint32_t slot = 0; slot < slot_count; ++slot) {
    max_bins = metadata[slot].bins > max_bins ? metadata[slot].bins : max_bins;
  }
  bool large = row_count > kSmallRows;
  if (max_bins != 0 && max_bins <= kUbMaxBins) {
    if ASCEND_IS_AIV {
      AscendC::TPipe pipe;
      AscendC::TBuf<AscendC::TPosition::VECCALC> hist_buf;
      pipe.InitBuffer(hist_buf, kUbTileCounters * sizeof(int32_t));
      uint64_t ub_addr = static_cast<uint64_t>(hist_buf.Get<int64_t>().GetPhyAddr());
      if (large) {
        asc_vf_call<IntegerHistogramUbTileVf<kLargeThreads>>(
            dim3(kLargeThreads), rows, grads, hess, metadata, row_count, slot_count, ub_addr);
      } else {
        asc_vf_call<IntegerHistogramUbTileVf<kSmallThreads>>(
            dim3(kSmallThreads), rows, grads, hess, metadata, row_count, slot_count, ub_addr);
      }
    }
  } else {
    if (large) {
      asc_vf_call<IntegerHistogramGmAtomicVf<kLargeThreads>>(
          dim3(kLargeThreads), rows, grads, hess, metadata, row_count, slot_count);
    } else {
      asc_vf_call<IntegerHistogramGmAtomicVf<kSmallThreads>>(
          dim3(kSmallThreads), rows, grads, hess, metadata, row_count, slot_count);
    }
  }
}

extern "C" void XgbNpuIntegerHistogramBuild(
    void* stream, void const* row_ids, void const* gradient, void const* hessian,
    void const* feature_metadata, uint64_t row_count, uint64_t feature_count) {
  if (!row_count || !feature_count) return;
  uint64_t block_limit = row_count > kSmallRows ? kLargeBlocks : kSmallBlocks;
  uint32_t blocks = feature_count < block_limit ? static_cast<uint32_t>(feature_count)
                                                : static_cast<uint32_t>(block_limit);
  IntegerHistogramBuildKernel<<<blocks, nullptr, stream>>>(
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(row_ids)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(gradient)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(hessian)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(feature_metadata)),
      row_count, feature_count);
}
