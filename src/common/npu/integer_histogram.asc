#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "simt_api/cpp/kernel_simt_intf.h"
#include "integer_histogram_abi.h"

namespace ih = xgboost::common::npu::histogram;

__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void IntegerHistogramBuildVf(
    __gm__ int64_t const* row_ids, __gm__ int64_t const* gradient,
    __gm__ int64_t const* hessian, __gm__ ih::FeatureDescriptor const* metadata,
    uint64_t row_count, uint64_t feature_count, uint32_t block, uint32_t blocks) {
  // On DAV-3510 a vector launch can expose physical block indices beyond
  // GetBlockNum(). Only the logical range participates: otherwise block 16
  // and block 0's second stride both atomically accumulate feature 16.
  if (block >= blocks) return;
  // A block owns one feature at a time. The block-strided feature loop keeps
  // launch geometry bounded while ensuring no two blocks write one feature.
  for (uint64_t feature = block; feature < feature_count; feature += blocks) {
    auto const& descriptor = metadata[feature];
    auto output_gradient = reinterpret_cast<__gm__ int64_t*>(descriptor.output_gradient);
    auto output_hessian = reinterpret_cast<__gm__ int64_t*>(descriptor.output_hessian);

    // Output bins are initialized cooperatively before any row contributes.
    // Zero-bin features retain their one-element placeholder and have no rows.
    uint64_t output_bins = descriptor.bins == 0 ? 1 : descriptor.bins;
    for (uint64_t bin = threadIdx.x; bin < output_bins; bin += 128) {
      output_gradient[bin] = 0;
      output_hessian[bin] = 0;
    }
    // Publish GM initialization before any thread issues GM atomic updates.
    // ThreadBarrier alone synchronizes execution, not global-memory visibility.
    AscendC::Simt::ThreadFence();
    AscendC::Simt::ThreadBarrier();
    if (descriptor.bins != 0) {
      auto input_column = reinterpret_cast<__gm__ int64_t const*>(descriptor.input_column);
      for (uint64_t position = threadIdx.x; position < row_count; position += 128) {
        auto row = row_ids[position];
        auto bin = input_column[row];
        if (bin == -1) continue;
        // Host validators prove 0 <= bin < descriptor.bins. The exact signed
        // int64 source channels are accumulated directly with GM atomics.
        AscendC::Simt::AtomicAdd(output_gradient + bin, gradient[row]);
        AscendC::Simt::AtomicAdd(output_hessian + bin, hessian[row]);
      }
    }
    AscendC::Simt::ThreadBarrier();
  }
}

extern "C" __global__ __aicore__ void IntegerHistogramBuildKernel(
    GM_ADDR row_ids, GM_ADDR gradient, GM_ADDR hessian, GM_ADDR feature_metadata,
    uint64_t row_count, uint64_t feature_count) {
  asc_vf_call<IntegerHistogramBuildVf>(dim3(128),
      reinterpret_cast<__gm__ int64_t const*>(row_ids),
      reinterpret_cast<__gm__ int64_t const*>(gradient),
      reinterpret_cast<__gm__ int64_t const*>(hessian),
      reinterpret_cast<__gm__ ih::FeatureDescriptor const*>(feature_metadata),
      row_count, feature_count, AscendC::GetBlockIdx(), AscendC::GetBlockNum());
}

extern "C" void XgbNpuIntegerHistogramBuild(
    void* stream, void const* row_ids, void const* gradient, void const* hessian,
    void const* feature_metadata, uint64_t row_count, uint64_t feature_count) {
  if (!row_count || !feature_count) return;
  uint32_t blocks = feature_count < 16 ? static_cast<uint32_t>(feature_count) : 16;
  IntegerHistogramBuildKernel<<<blocks, nullptr, stream>>>(
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(row_ids)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(gradient)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(hessian)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(feature_metadata)),
      row_count, feature_count);
}
