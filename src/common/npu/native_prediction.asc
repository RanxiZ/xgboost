#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "native_prediction_abi.h"

namespace native = xgboost::common::npu::native_abi;

__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void PredictVf(
    __gm__ native::Node const* nodes, __gm__ native::Tree const* trees,
    __gm__ uint64_t const* offsets, __gm__ native::Entry const* entries,
    __gm__ float const* input, __gm__ float* output, __gm__ native::Status* status,
    uint32_t nrows, uint32_t ngroups,
    uint32_t ntree, uint32_t tree_begin, uint32_t tree_end, uint32_t block, uint32_t blocks) {
  constexpr float kMax = 0x1.fffffep127f;
  for (uint64_t row = static_cast<uint64_t>(block) * 128 + threadIdx.x;
       row < nrows; row += static_cast<uint64_t>(blocks) * 128) {
    auto begin = offsets[row];
    auto end = offsets[row + 1];
    // CUDA scalar PredictKernel sums this requested tree range from zero,
    // then adds it once to the initialized/cached margin. Reassociation with
    // the initial margin changes float32 results for multi-tree predictions.
    float row_prediction = 0.0f;
    uint32_t diagnostic_tid = UINT32_MAX;
    int32_t node_id = -1;
    uint32_t steps = 0;
    native::Tree diagnostic_tree{};
    native::Node diagnostic_node{};
    float diagnostic_previous = 0.0f;
    float diagnostic_value = 0.0f;
    float diagnostic_result = 0.0f;
    uint32_t error_bits = 0;
#define NATIVE_REPORT_PREDICT(bits) error_bits |= (bits)
    if (ngroups != 1 || tree_begin > tree_end || tree_end > ntree || begin > end) {
      NATIVE_REPORT_PREDICT(native::kPredictShape);
    }
    bool failed = error_bits != 0;
    for (uint32_t tid = tree_begin; tid < tree_end && !failed; ++tid) {
      auto const& tree = trees[tid];
      diagnostic_tid = tid;
      diagnostic_tree.first_node = tree.first_node;
      diagnostic_tree.node_count = tree.node_count;
      diagnostic_tree.group = tree.group;
      // Widen before adding. The CANN VF optimizer miscompiles the uint32
      // subtraction form (first > UINT32_MAX - (count - 1)) for nonzero offsets,
      // spuriously entering the rejection path for valid later trees.
      uint64_t node_end = static_cast<uint64_t>(tree.first_node) + tree.node_count;
      if (tree.group >= ngroups || tree.node_count == 0 || node_end > uint64_t{0x100000000ULL}) {
        uint32_t tree_error = 0;
        if (tree.group >= ngroups) tree_error |= native::kPredictTree;
        if (tree.node_count == 0) tree_error |= native::kPredictEmptyTree;
        if (node_end > uint64_t{0x100000000ULL}) tree_error |= native::kPredictTreeOverflow;
        NATIVE_REPORT_PREDICT(tree_error);
        break;
      }
      node_id = 0;
      steps = 0;
      while (true) {
        bool invalid_node = node_id < 0 || static_cast<uint32_t>(node_id) >= tree.node_count;
        bool cycle = ++steps > tree.node_count;
        if (invalid_node || cycle) {
          NATIVE_REPORT_PREDICT((invalid_node ? native::kPredictNode : 0U) |
                                (cycle ? native::kPredictCycle : 0U));
          failed = true;
          break;
        }
        auto const& current = nodes[tree.first_node + static_cast<uint32_t>(node_id)];
        diagnostic_node.left = current.left;
        diagnostic_node.right = current.right;
        diagnostic_node.feature = current.feature;
        diagnostic_node.threshold = current.threshold;
        diagnostic_node.leaf = current.leaf;
        diagnostic_node.is_leaf = current.is_leaf;
        diagnostic_node.default_left = current.default_left;
        if (current.is_leaf) {
          float previous = row_prediction;
          // Ordered comparisons reject both infinities and NaN. Check the
          // addition itself, not just operands: finite float32 can overflow.
          float prediction = previous + current.leaf;
          diagnostic_previous = previous;
          diagnostic_result = prediction;
          uint32_t arithmetic_error = 0;
          if (!(previous >= -kMax && previous <= kMax)) arithmetic_error |= native::kPredictPrevious;
          if (!(current.leaf >= -kMax && current.leaf <= kMax)) arithmetic_error |= native::kPredictLeaf;
          if (!(prediction >= -kMax && prediction <= kMax)) arithmetic_error |= native::kPredictAddition;
          if (arithmetic_error) {
            NATIVE_REPORT_PREDICT(arithmetic_error);
            failed = true;
          } else {
            row_prediction = prediction;
          }
          break;
        }
        // Infinite numerical thresholds are valid tree split sentinels. NaN
        // thresholds, invalid children and cycles are rejected explicitly.
        if (current.threshold != current.threshold || current.left < 0 || current.right < 0 ||
            static_cast<uint32_t>(current.left) >= tree.node_count ||
            static_cast<uint32_t>(current.right) >= tree.node_count) {
          NATIVE_REPORT_PREDICT((current.threshold != current.threshold ? native::kPredictThreshold : 0U) |
                                (current.left < 0 || current.right < 0 ||
                                 static_cast<uint32_t>(current.left) >= tree.node_count ||
                                 static_cast<uint32_t>(current.right) >= tree.node_count ?
                                 native::kPredictChild : 0U));
          failed = true;
          break;
        }
        // Host binding validates sorted, unique feature indices once. Binary
        // search avoids scanning every nonzero at every tree split.
        uint64_t lo = begin;
        uint64_t hi = end;
        while (lo < hi) {
          auto mid = lo + (hi - lo) / 2;
          if (entries[mid].feature < current.feature) lo = mid + 1;
          else hi = mid;
        }
        bool found = lo < end && entries[lo].feature == current.feature;
        float value = found ? entries[lo].value : 0.0f;
        if (found && value == value && !(value >= -kMax && value <= kMax)) {
          diagnostic_value = value;
          NATIVE_REPORT_PREDICT(native::kPredictFeature);
          failed = true;
          break;
        }
        bool missing = !found || value != value;
        node_id = missing ? (current.default_left ? current.left : current.right)
                          : (value < current.threshold ? current.left : current.right);
      }
    }
    if (!error_bits) {
      float initial = input[row];
      float prediction = initial + row_prediction;
      if (!(initial >= -kMax && initial <= kMax)) error_bits |= native::kPredictPrevious;
      if (!(prediction >= -kMax && prediction <= kMax)) error_bits |= native::kPredictAddition;
      diagnostic_previous = initial;
      diagnostic_result = prediction;
      if (!error_bits) output[row] = prediction;
    }
    if (error_bits) {
      asc_atomic_or(&status->error, error_bits);
      if (asc_atomic_cas(&status->claimed, uint32_t{0}, uint32_t{1}) == 0) {
        status->first_error = error_bits;
        status->row = static_cast<uint32_t>(row);
        status->tree = diagnostic_tid;
        status->node = node_id;
        status->steps = steps;
        status->first_node = diagnostic_tree.first_node;
        status->node_count = diagnostic_tree.node_count;
        status->group = diagnostic_tree.group;
        status->observed_node.left = diagnostic_node.left;
        status->observed_node.right = diagnostic_node.right;
        status->observed_node.feature = diagnostic_node.feature;
        status->observed_node.threshold = diagnostic_node.threshold;
        status->observed_node.leaf = diagnostic_node.leaf;
        status->observed_node.is_leaf = diagnostic_node.is_leaf;
        status->observed_node.default_left = diagnostic_node.default_left;
        status->previous = diagnostic_previous;
        status->value = diagnostic_value;
        status->result = diagnostic_result;
        status->row_begin = begin;
        status->row_end = end;
        status->reserved = ngroups;
      }
    }
  }
#undef NATIVE_REPORT_PREDICT
}

extern "C" __global__ __aicore__ void NativePredictKernel(
    GM_ADDR nodes, GM_ADDR trees, GM_ADDR offsets, GM_ADDR entries, GM_ADDR input, GM_ADDR output,
    GM_ADDR status, uint32_t nrows, uint32_t ngroups, uint32_t ntree,
    uint32_t tree_begin, uint32_t tree_end) {
  asc_vf_call<PredictVf>(dim3(128), reinterpret_cast<__gm__ native::Node const*>(nodes),
                         reinterpret_cast<__gm__ native::Tree const*>(trees),
                         reinterpret_cast<__gm__ uint64_t const*>(offsets),
                         reinterpret_cast<__gm__ native::Entry const*>(entries),
                         reinterpret_cast<__gm__ float const*>(input),
                         reinterpret_cast<__gm__ float*>(output),
                         reinterpret_cast<__gm__ native::Status*>(status), nrows, ngroups, ntree,
                         tree_begin, tree_end, AscendC::GetBlockIdx(), AscendC::GetBlockNum());
}

extern "C" void XgbNpuNativePredict(void* stream, void const* nodes, void const* trees,
                                     void const* offsets, void const* entries,
                                     void const* input, void* output,
                                     void* status, uint32_t nrows, uint32_t ngroups, uint32_t ntree,
                                     uint32_t tree_begin, uint32_t tree_end) {
  if (!nrows || tree_begin == tree_end) return;
  uint32_t blocks = (nrows - 1) / 128 + 1;
  if (blocks > 16) blocks = 16;
  NativePredictKernel<<<blocks, nullptr, stream>>>(
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(nodes)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(trees)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(offsets)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(entries)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(input)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(output)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(status)), nrows, ngroups, ntree,
      tree_begin, tree_end);
}

__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void SquareErrorVf(
    __gm__ float const* predictions, __gm__ float const* labels, __gm__ float const* weights,
    __gm__ float* gradient, __gm__ float* hessian, __gm__ native::Status* status,
    uint32_t count, float scale_pos_weight, uint32_t block, uint32_t blocks) {
  constexpr float kMax = 0x1.fffffep127f;
  for (uint64_t i = static_cast<uint64_t>(block) * 128 + threadIdx.x;
       i < count; i += static_cast<uint64_t>(blocks) * 128) {
    float p = predictions[i];
    float y = labels[i];
    float w = weights ? weights[i] : 1.0f;
    bool valid = p >= -kMax && p <= kMax && y >= -kMax && y <= kMax &&
                 w >= 0.0f && w <= kMax && scale_pos_weight >= 0.0f && scale_pos_weight <= kMax;
    if (y == 1.0f) w *= scale_pos_weight;
    float difference = p - y;
    float g = difference * w;
    // Also reject overflowing intermediates, even when zero weight would mask
    // them; NaN/Inf must never enter the resident histogram builder.
    valid = valid && w >= 0.0f && w <= kMax && difference >= -kMax && difference <= kMax &&
            g >= -kMax && g <= kMax;
    if (!valid) {
      uint32_t error = 0;
      if (!(p >= -kMax && p <= kMax && y >= -kMax && y <= kMax)) error |= native::kSquareInput;
      if (!(w >= 0.0f && w <= kMax && scale_pos_weight >= 0.0f && scale_pos_weight <= kMax)) {
        error |= native::kSquareWeight;
      }
      if (!(difference >= -kMax && difference <= kMax)) error |= native::kSquareDifference;
      if (!(g >= -kMax && g <= kMax)) error |= native::kSquareGradient;
      asc_atomic_or(&status->error, error);
      gradient[i] = 0.0f;
      hessian[i] = 0.0f;
    } else {
      gradient[i] = g;
      hessian[i] = w;
    }
  }
}

extern "C" __global__ __aicore__ void NativeSquareErrorKernel(
    GM_ADDR predictions, GM_ADDR labels, GM_ADDR weights, GM_ADDR gradient, GM_ADDR hessian,
    GM_ADDR status, uint32_t count, float scale_pos_weight) {
  asc_vf_call<SquareErrorVf>(dim3(128), reinterpret_cast<__gm__ float const*>(predictions),
                             reinterpret_cast<__gm__ float const*>(labels),
                             reinterpret_cast<__gm__ float const*>(weights),
                             reinterpret_cast<__gm__ float*>(gradient),
                             reinterpret_cast<__gm__ float*>(hessian),
                             reinterpret_cast<__gm__ native::Status*>(status), count, scale_pos_weight,
                             AscendC::GetBlockIdx(), AscendC::GetBlockNum());
}

extern "C" void XgbNpuNativeSquareError(void* stream, void const* predictions,
                                         void const* labels, void const* weights,
                                         void* gradient, void* hessian, void* status,
                                         uint32_t count, float scale_pos_weight) {
  if (!count) return;
  uint32_t blocks = (count - 1) / 128 + 1;
  if (blocks > 16) blocks = 16;
  NativeSquareErrorKernel<<<blocks, nullptr, stream>>>(
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(predictions)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(labels)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(weights)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(gradient)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(hessian)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(status)), count, scale_pos_weight);
}