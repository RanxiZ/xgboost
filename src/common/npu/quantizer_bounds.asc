// Fused dynamic-quantizer bounds: one SIMT launch replaces the twelve-aclnn
// FloatBits/AndBits/Shift/Compare/SumControl/Where/Add/ScatterSum chain.
//
// DAV-3510 SIMT facts this design rests on (see integer_histogram.asc):
//   * one VF may only touch ~8KB of dynamically indexed UB;
//   * UB int64 atomics do not exist, but int32 UB atomics do;
//   * a 64-bit bucket is kept as (int32 low word in UB, int32 carry count in
//     UB), where the carry count is bumped only on unsigned low-word overflow,
//     so the pair reproduces the exact int64 sum for any |value| < 2^63.
//
// Per block: 512 low words + 512 carry counters + 1 control word (4.1KB UB).
// Each thread folds one float32 bit pattern at a time into the UB histogram;
// a block owns a contiguous input slice and publishes its partial int64 sums
// with GM atomics into the host-visible 513-word summary. Buckets 255/511 are
// never touched (NaN/Inf is counted in the control word instead), which keeps
// the CertifyScale invariant that they stay zero.
//
// The summary needs to be zero before the atomics run. Block 0 therefore clears
// the *alternate* summary buffer inside the same launch, so the host can ping
// pong between two device buffers and never issues a memset/synchronize of its
// own (the stream order makes the cleared buffer visible to the next launch).
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "simt_api/cpp/kernel_simt_intf.h"
#include "quantizer_bounds_abi.h"

namespace qb = xgboost::common::npu::quantizer;

namespace {
constexpr uint32_t kBoundsThreads = 1024;
constexpr uint32_t kBoundsBlocks = 64;
constexpr uint32_t kBuckets = 512;
constexpr uint32_t kSummaryWords = static_cast<uint32_t>(qb::kBoundsOutputCount);
constexpr uint32_t kUbWords = 2 * kBuckets + 1;
constexpr uint32_t kUbBytes = ((kUbWords * sizeof(int32_t) + 31) / 32) * 32;
constexpr uint32_t kImplicitBit = 1u << 23;
constexpr uint32_t kMantissaMask = kImplicitBit - 1;
constexpr uint32_t kMaxAbsolute = 0x7fffffffu;

template <uint32_t kThreads>
__simt_vf__ __aicore__ LAUNCH_BOUND(kThreads) inline void DynamicQuantizeBoundsVf(
    __gm__ int32_t const* bits, uint64_t count, __gm__ int64_t* output,
    __gm__ int64_t* next_summary, uint32_t block, uint64_t ub_addr) {
  // DAV-3510: UB pointers cannot be passed directly through asc_vf_call;
  // marshal the physical UB address as uint64_t and cast inside the VF.
  __ubuf__ int32_t* lo = reinterpret_cast<__ubuf__ int32_t*>(ub_addr);
  __ubuf__ int32_t* hi = lo + kBuckets;
  __ubuf__ int32_t* control = hi + kBuckets;
  for (uint32_t i = threadIdx.x; i < 2 * kBuckets; i += kThreads) {
    lo[i] = 0;
  }
  if (threadIdx.x == 0) {
    *control = 0;
  }
  if (block == 0) {
    // Plain stores, exact for the 513 int64 words of the following reduction.
    for (uint32_t i = threadIdx.x; i < kSummaryWords; i += kThreads) {
      next_summary[i] = 0;
    }
  }
  AscendC::Simt::ThreadFence();
  AscendC::Simt::ThreadBarrier();
  uint32_t invalid = 0;
  for (uint64_t pos = threadIdx.x; pos < count; pos += kThreads) {
    int32_t value = bits[pos];
    uint32_t absolute = static_cast<uint32_t>(value) & kMaxAbsolute;
    uint32_t exponent = absolute >> 23;
    if (exponent == 255) {
      // NaN/Inf: never fold into a bucket (255/511 must stay zero); the host
      // raises the original rejection when the control word is nonzero.
      ++invalid;
      continue;
    }
    uint32_t fraction = absolute & kMantissaMask;
    uint32_t implicit = exponent == 0 ? 0u : kImplicitBit;
    int32_t mantissa = static_cast<int32_t>(fraction + implicit);
    uint32_t index = exponent + (value < 0 ? 256u : 0u);  // [0,254] or [256,510]
    int32_t old_lo = AscendC::Simt::AtomicAdd(lo + index, mantissa);
    uint32_t sum = static_cast<uint32_t>(old_lo) + static_cast<uint32_t>(mantissa);
    if (sum < static_cast<uint32_t>(old_lo)) {
      AscendC::Simt::AtomicAdd(hi + index, 1);
    }
  }
  if (invalid != 0) {
    AscendC::Simt::AtomicAdd(control, static_cast<int32_t>(invalid));
  }
  AscendC::Simt::ThreadFence();
  AscendC::Simt::ThreadBarrier();
  for (uint32_t b = threadIdx.x; b < kBuckets; b += kThreads) {
    // value == hi * 2^32 + (uint32)lo, exact; the carry count is nonnegative.
    int64_t value = (static_cast<int64_t>(hi[b]) << 32) | static_cast<uint32_t>(lo[b]);
    if (value != 0) {
      AscendC::Simt::AtomicAdd(output + b, value);
    }
  }
  if (threadIdx.x == 0 && *control != 0) {
    AscendC::Simt::AtomicAdd(output + qb::kBoundsControlIndex,
                             static_cast<int64_t>(*control));
  }
}
}  // namespace

extern "C" __global__ __aicore__ void DynamicQuantizeBoundsKernel(
    GM_ADDR input, uint64_t count, GM_ADDR output, GM_ADDR next_summary) {
  uint32_t block = AscendC::GetBlockIdx();
  uint32_t blocks = AscendC::GetBlockNum();
  if (block >= blocks) return;
  // Every block runs the VF even for an empty slice: an empty slice performs no
  // atomics, and block 0 must still clear the alternate summary.
  uint64_t begin = static_cast<uint64_t>(block) * count / blocks;
  uint64_t end = static_cast<uint64_t>(block + 1) * count / blocks;
  if ASCEND_IS_AIV {
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> histogram;
    pipe.InitBuffer(histogram, kUbBytes);
    uint64_t ub_addr = static_cast<uint64_t>(histogram.Get<int32_t>().GetPhyAddr());
    asc_vf_call<DynamicQuantizeBoundsVf<kBoundsThreads>>(
        dim3(kBoundsThreads), reinterpret_cast<__gm__ int32_t const*>(input) + begin,
        end - begin, reinterpret_cast<__gm__ int64_t*>(output),
        reinterpret_cast<__gm__ int64_t*>(next_summary), block, ub_addr);
  }
}

extern "C" void XgbNpuDynamicQuantizeBounds(
    void* stream, void const* input, uint64_t count, void* output, void* next_summary) {
  if (!count) return;
  DynamicQuantizeBoundsKernel<<<kBoundsBlocks, nullptr, stream>>>(
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(input)), count,
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(output)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(next_summary)));
}
