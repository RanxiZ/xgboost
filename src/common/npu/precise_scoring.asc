#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#define XGB_NPU_PRECISE_INLINE __aicore__ inline
#include "precise_scoring_abi.h"
namespace precision=xgboost::common::npu::precise;
__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void ScoreVf(
    __gm__ precision::Input const* input,__gm__ precision::Score* output,
    uint32_t count,uint32_t block,uint32_t blocks) {
  for (uint64_t i=static_cast<uint64_t>(block)*128+threadIdx.x;i<count;i+=static_cast<uint64_t>(blocks)*128) {
    auto const& v=input[i];
    precision::Parameters parameters{
      v.parameters.min_child_weight, v.parameters.reg_lambda,
      v.parameters.reg_alpha, v.parameters.max_delta_step,
      v.parameters.gradient_scale, v.parameters.hessian_scale};
    auto score=precision::Evaluate(v.left_gradient,v.left_hessian,
                                   v.right_gradient,v.right_hessian,parameters);
    output[i].left_weight=score.left_weight;
    output[i].right_weight=score.right_weight;
    output[i].gain=score.gain;
    output[i].error=score.error;
  }
}
extern "C" __global__ __aicore__ void PreciseScoreKernel(GM_ADDR input,GM_ADDR output,uint32_t count) {
  asc_vf_call<ScoreVf>(dim3(128),reinterpret_cast<__gm__ precision::Input const*>(input),
                     reinterpret_cast<__gm__ precision::Score*>(output),count,
                     AscendC::GetBlockIdx(),AscendC::GetBlockNum());
}
extern "C" void XgbNpuPreciseScore(void* stream,void const* input,void* output,uint32_t count) {
  if (!count) return;
  uint32_t blocks=(count-1)/128+1; if (blocks>16) blocks=16;
  PreciseScoreKernel<<<blocks,nullptr,stream>>>(reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(input)),
                                                 reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(output)),count);
}
__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void ColumnsVf(
    __gm__ int64_t const* lg,__gm__ int64_t const* lh,__gm__ int64_t const* rg,__gm__ int64_t const* rh,
    __gm__ precision::Parameters const* p,__gm__ precision::Score* output,__gm__ int64_t* errors,
    uint32_t count,uint32_t block,uint32_t blocks) {
  precision::Parameters parameters{p->min_child_weight,p->reg_lambda,p->reg_alpha,p->max_delta_step,
                                   p->gradient_scale,p->hessian_scale};
  for (uint64_t i=static_cast<uint64_t>(block)*128+threadIdx.x;i<count;i+=static_cast<uint64_t>(blocks)*128) {
    auto score=precision::Evaluate(lg[i],lh[i],rg[i],rh[i],parameters);
    output[i].left_weight=score.left_weight; output[i].right_weight=score.right_weight;
    output[i].gain=score.gain; output[i].error=score.error; errors[i]=score.error;
  }
}
extern "C" __global__ __aicore__ void ScoreColumnsKernel(
    GM_ADDR lg,GM_ADDR lh,GM_ADDR rg,GM_ADDR rh,GM_ADDR p,GM_ADDR output,GM_ADDR errors,uint32_t count) {
  asc_vf_call<ColumnsVf>(dim3(128),reinterpret_cast<__gm__ int64_t const*>(lg),
    reinterpret_cast<__gm__ int64_t const*>(lh),reinterpret_cast<__gm__ int64_t const*>(rg),
    reinterpret_cast<__gm__ int64_t const*>(rh),reinterpret_cast<__gm__ precision::Parameters const*>(p),
    reinterpret_cast<__gm__ precision::Score*>(output),reinterpret_cast<__gm__ int64_t*>(errors),
    count,AscendC::GetBlockIdx(),AscendC::GetBlockNum());
}
extern "C" void XgbNpuScoreColumns(void* stream,void const* lg,void const* lh,void const* rg,void const* rh,
                                   void const* p,void* output,void* errors,uint32_t count) {
  if (!count) return;
  uint32_t blocks=(count-1)/128+1; if (blocks>16) blocks=16;
  ScoreColumnsKernel<<<blocks,nullptr,stream>>>(
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(lg)),
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(lh)),
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(rg)),
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(rh)),
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(p)),
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(output)),
    reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(errors)),count);
}
