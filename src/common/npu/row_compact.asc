// Copyright 2026, XGBoost Contributors
// Fused numerical row partition (see row_compact_abi.h).
//
// Structural difference from a count -> exclusive-scan -> scatter pipeline:
//   * only the LEFT child is ever counted; a right row at node position i is
//     written at (i - left prefix before i), which is exactly the ascending
//     order of the CPU reference, so no count/prefix pass exists for it;
//   * the block/warp bases are recovered in pass 2 from the small per-warp count
//     array (<= 64 blocks, 16 warps) by a warp-cooperative reduction, so no
//     standalone scan kernel runs and the host never reads the child count
//     between the two launches;
//   * pass 1 stores a one-byte left flag, so pass 2 never re-gathers the column;
//   * bin range validation rides inside pass 1 through a generation-stamped
//     control word, replacing the ACLNN compare/cast/reduce chain and its sync;
//   * both children are written straight into the caller's arena slot, dropping
//     the packed scratch buffer and the trailing gather of the baseline.
//
// Synchronization note: the two passes are separate launches on one stream, so
// every pass-2 read of pass-1 GM output is ordered by the stream. Inside a single
// launch we deliberately do NOT hand values between warps through GM: on this
// target ThreadFence/ThreadBarrier are block-local primitives and a cross-warp
// GM hand-off was observed to return stale zeros under load. The only
// intra-launch communication here is the warp reduction (intra-warp) and, in
// pass 1, the per-warp counter each warp owns exclusively.
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "simt_api/cpp/kernel_simt_intf.h"
#include "row_compact_abi.h"

namespace rc = xgboost::common::npu::rowcompact;

namespace {
using u32 = uint32_t;
using i32 = int32_t;
using i64 = int64_t;

constexpr u32 kThreads = rc::kRowCompactThreads;
constexpr u32 kWarps = kThreads / 32;

// One warp owns one contiguous segment of the node, so (block, warp, lane) is the
// ascending row order. Pass 1 and pass 2 must agree bit for bit on the split.
__SIMT_DEVICE_FUNCTIONS_DECL__ inline i64 SegmentSpan(i64 count, u32 blocks) {
  return (count + static_cast<i64>(blocks) - 1) / static_cast<i64>(blocks);
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline i64 SegmentBegin(i64 count, u32 blocks, u32 block) {
  i64 per = SegmentSpan(count, blocks);
  i64 lo = static_cast<i64>(block) * per;
  return lo < count ? lo : count;
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline i64 SegmentLimit(i64 count, u32 blocks, u32 block) {
  i64 per = SegmentSpan(count, blocks);
  i64 hi = static_cast<i64>(block) * per + per;
  return hi < count ? hi : count;
}

// Rows of one warp segment: [begin, begin + seglen) of the block interval.
__SIMT_DEVICE_FUNCTIONS_DECL__ inline i64 WarpBegin(i64 count, u32 blocks, u32 block, u32 warp) {
  i64 lo = SegmentBegin(count, blocks, block);
  i64 hi = SegmentLimit(count, blocks, block);
  i64 seg = (hi - lo + static_cast<i64>(kWarps) - 1) / static_cast<i64>(kWarps);
  i64 begin = lo + static_cast<i64>(warp) * seg;
  return begin < hi ? begin : hi;
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline i64 WarpLimit(i64 count, u32 blocks, u32 block, u32 warp) {
  i64 lo = SegmentBegin(count, blocks, block);
  i64 hi = SegmentLimit(count, blocks, block);
  i64 seg = (hi - lo + static_cast<i64>(kWarps) - 1) / static_cast<i64>(kWarps);
  i64 limit = lo + (static_cast<i64>(warp) + 1) * seg;
  return limit < hi ? limit : hi;
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline bool BinIsLeft(i64 bin, i64 candidate, bool missing_left) {
  bool missing = bin == -1;
  bool numerical = bin < candidate;
  return missing_left ? (missing || numerical) : (!missing && numerical);
}

// Pass 1: left flag per row, per-warp left counts, range rejection.
__simt_vf__ __aicore__ LAUNCH_BOUND(kThreads) inline void RowCompactCountVf(
    __gm__ i64 const* row_ids, __gm__ i64 const* column, __gm__ uint8_t* flags,
    __gm__ i32* warp_counts, __gm__ i32* control, i64 row_count, i64 bins_max, i64 candidate,
    i32 missing_left, u32 blocks, u32 block, u32 generation) {
  u32 tid = threadIdx.x;
  u32 warp = tid >> 5;
  u32 lane = tid & 31u;
  i64 begin = WarpBegin(row_count, blocks, block, warp);
  i64 limit = WarpLimit(row_count, blocks, block, warp);
  bool missing_left_flag = missing_left != 0;
  i32 tally = 0;
  bool rejected = false;
  for (i64 p = begin + static_cast<i64>(lane); p < limit; p += 32) {
    i64 row = row_ids[p];
    i64 bin = column[row];
    // Same domain as the ACLNN guard: -1 is the only missing value.
    if (bin < -1 || bin > bins_max - 1) rejected = true;
    bool left = BinIsLeft(bin, candidate, missing_left_flag);
    flags[p] = left ? static_cast<uint8_t>(1) : static_cast<uint8_t>(0);
    tally += left ? 1 : 0;
  }
  if (rejected) control[rc::kRowCompactControlViolation] = static_cast<i32>(generation);
  // Each warp owns its own counter slot, so the hand-off to pass 2 is a plain GM
  // store read by the NEXT launch. No two warps ever touch the same word.
  i32 warp_total = AscendC::Simt::WarpReduceAddSync<i32>(tally);
  if (lane == 0) warp_counts[block * kWarps + warp] = warp_total;
}

// Pass 2: both children from the single left flag; right position = row position
// minus the left prefix, so the right child needs no count/prefix of its own.
__simt_vf__ __aicore__ LAUNCH_BOUND(kThreads) inline void RowCompactWriteVf(
    __gm__ i64 const* row_ids, __gm__ uint8_t const* flags, __gm__ i32 const* warp_counts,
    i64 row_count, u32 blocks, __gm__ i64* out_left, u32 block) {
  u32 tid = threadIdx.x;
  u32 warp = tid >> 5;
  u32 lane = tid & 31u;
  i64 begin = WarpBegin(row_count, blocks, block, warp);
  i64 limit = WarpLimit(row_count, blocks, block, warp);
  // Block bases and the child total come from the pass-1 warp counts. Every lane
  // sums a strided subset of the (<= 64 x 16) counters and a warp reduction folds
  // the partials: integer addition is associative, so both sums are exact and
  // order-free, and the GM traffic per lane is O(kWarps + kBlocks / 32) instead of
  // O(kWarps * kBlocks). The within-block warp prefix is the block's own 16
  // counters, identical in every lane.
  i32 base_part = 0;
  i32 total_part = 0;
  u32 counts = blocks * kWarps;
  for (u32 i = lane; i < counts; i += 32) {
    i32 count = warp_counts[i];
    total_part += count;
    if (i / kWarps < block) base_part += count;
  }
  i64 base = static_cast<i64>(AscendC::Simt::WarpReduceAddSync<i32>(base_part));
  i64 total = static_cast<i64>(AscendC::Simt::WarpReduceAddSync<i32>(total_part));
  i64 seg_base = base;
  for (u32 w = 0; w < warp; ++w) seg_base += warp_counts[block * kWarps + w];
  __gm__ i64* out_right = out_left + total;
  i64 running = 0;
  for (i64 g = begin; g < limit; g += 32) {
    i64 position = g + static_cast<i64>(lane);
    bool live = position < limit;
    i32 left = (live && flags[position] != 0) ? 1 : 0;
    u32 mask = AscendC::Simt::WarpBallotSync(left);
    i32 below = AscendC::Simt::Popc(mask & ((1u << lane) - 1u));
    if (live) {
      i64 row = row_ids[position];
      if (left) {
        out_left[seg_base + running + below] = row;
      } else {
        out_right[position - seg_base - running - below] = row;
      }
    }
    running += static_cast<i64>(AscendC::Simt::Popc(mask));
  }
}
}  // namespace

extern "C" __global__ __aicore__ void RowCompactCountKernel(
    GM_ADDR row_ids, GM_ADDR column, GM_ADDR flags, GM_ADDR warp_counts, GM_ADDR block_counts,
    GM_ADDR control, int64_t row_count, int64_t bins_max, int64_t candidate,
    int32_t missing_left, uint32_t blocks, uint32_t generation) {
  (void)block_counts;  // reserved slot kept for ABI stability; no block totals are published
  if ASCEND_IS_AIV {
    asc_vf_call<RowCompactCountVf>(
        dim3(kThreads), reinterpret_cast<__gm__ i64 const*>(row_ids),
        reinterpret_cast<__gm__ i64 const*>(column), reinterpret_cast<__gm__ uint8_t*>(flags),
        reinterpret_cast<__gm__ i32*>(warp_counts), reinterpret_cast<__gm__ i32*>(control),
        row_count, bins_max, candidate, missing_left, blocks, AscendC::GetBlockIdx(), generation);
  }
}

extern "C" __global__ __aicore__ void RowCompactWriteKernel(
    GM_ADDR row_ids, GM_ADDR flags, GM_ADDR warp_counts, GM_ADDR block_counts,
    int64_t row_count, uint32_t blocks, GM_ADDR out_left) {
  (void)block_counts;
  asc_vf_call<RowCompactWriteVf>(
      dim3(kThreads), reinterpret_cast<__gm__ i64 const*>(row_ids),
      reinterpret_cast<__gm__ uint8_t const*>(flags),
      reinterpret_cast<__gm__ i32 const*>(warp_counts), row_count, blocks,
      reinterpret_cast<__gm__ i64*>(out_left), AscendC::GetBlockIdx());
}

extern "C" void XgbNpuRowCompactCount(
    void* stream, void const* row_ids, void const* column, int64_t row_count, int64_t bins_max,
    int64_t candidate, uint32_t missing_left, uint32_t blocks, void* flags, void* warp_counts,
    void* block_counts, void* control, uint32_t generation) {
  if (!row_count || !blocks) return;
  RowCompactCountKernel<<<blocks, nullptr, stream>>>(
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(row_ids)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(column)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(flags)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(warp_counts)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(block_counts)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(control)), row_count, bins_max,
      candidate, static_cast<int32_t>(missing_left), blocks, generation);
}

extern "C" void XgbNpuRowCompactWrite(
    void* stream, void const* row_ids, void const* flags, void const* warp_counts,
    void const* block_counts, int64_t row_count, uint32_t blocks, void* out_left) {
  if (!row_count || !blocks) return;
  RowCompactWriteKernel<<<blocks, nullptr, stream>>>(
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(row_ids)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(flags)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(warp_counts)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(block_counts)), row_count, blocks,
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(out_left)));
}
