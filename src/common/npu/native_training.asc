#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "native_training_abi.h"
#define XGB_NPU_SAMPLER_INLINE __aicore__ inline
#include "cuda_row_sampler.h"
#undef XGB_NPU_SAMPLER_INLINE

namespace nt = xgboost::common::npu::native_abi;

__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void NativeBinRowsVf(
    __gm__ uint64_t const* offsets, __gm__ nt::Entry const* entries,
    __gm__ uint32_t const* ptrs, __gm__ float const* cuts,
    __gm__ uint64_t const* columns, uint32_t nrows, uint32_t nfeatures,
    uint32_t block, uint32_t blocks) {
  for (uint64_t row = static_cast<uint64_t>(block) * 128 + threadIdx.x;
       row < nrows; row += static_cast<uint64_t>(blocks) * 128) {
    for (uint32_t f = 0; f < nfeatures; ++f) {
      reinterpret_cast<__gm__ int64_t*>(columns[f])[row] = -1;
    }
    for (uint64_t i = offsets[row]; i < offsets[row + 1]; ++i) {
      uint32_t f = entries[i].feature;
      float value = entries[i].value;
      uint32_t begin = ptrs[f], end = ptrs[f + 1];
      if (value != value || begin == end) continue;
      uint32_t lo = begin, hi = end;
      while (lo < hi) {
        uint32_t mid = lo + (hi - lo) / 2;
        if (value < cuts[mid]) hi = mid;
        else lo = mid + 1;
      }
      if (lo == end) --lo;
      reinterpret_cast<__gm__ int64_t*>(columns[f])[row] = static_cast<int64_t>(lo - begin);
    }
  }
}

extern "C" __global__ __aicore__ void NativeBinRowsKernel(
    GM_ADDR offsets, GM_ADDR entries, GM_ADDR ptrs, GM_ADDR cuts, GM_ADDR columns,
    uint32_t nrows, uint32_t nfeatures) {
  asc_vf_call<NativeBinRowsVf>(dim3(128), reinterpret_cast<__gm__ uint64_t const*>(offsets),
      reinterpret_cast<__gm__ nt::Entry const*>(entries),
      reinterpret_cast<__gm__ uint32_t const*>(ptrs), reinterpret_cast<__gm__ float const*>(cuts),
      reinterpret_cast<__gm__ uint64_t const*>(columns), nrows, nfeatures,
      AscendC::GetBlockIdx(), AscendC::GetBlockNum());
}

extern "C" void XgbNpuNativeBinRows(void* stream, void const* offsets, void const* entries,
    void const* ptrs, void const* cuts, void const* columns, uint32_t nrows, uint32_t nfeatures) {
  if (!nrows || !nfeatures) return;
  uint32_t blocks = (nrows - 1) / 128 + 1;
  if (blocks > 16) blocks = 16;
  NativeBinRowsKernel<<<blocks, nullptr, stream>>>(
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(offsets)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(entries)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(ptrs)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(cuts)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(columns)), nrows, nfeatures);
}

// Pinned CUDA RandomWeight, independent of launch geometry and device state.
__simt_vf__ __aicore__ LAUNCH_BOUND(128) inline void NativeSampleRowsVf(
    __gm__ uint32_t const* gradient, __gm__ uint32_t const* hessian,
    __gm__ uint32_t* out_gradient, __gm__ uint32_t* out_hessian,
    uint32_t nrows, uint64_t seed, float subsample, uint32_t block, uint32_t blocks) {
  for (uint64_t row = static_cast<uint64_t>(block) * 128 + threadIdx.x;
       row < nrows; row += static_cast<uint64_t>(blocks) * 128) {
    bool keep = xgboost::common::npu::CudaKeepRow(static_cast<uint32_t>(seed), row, subsample);
    // Integer loads/stores preserve float32 subnormal, signed zero and NaN
    // bits; no float multiplication by a mask and no host gradient copies.
    out_gradient[row] = keep ? gradient[row] : 0U;
    out_hessian[row] = keep ? hessian[row] : 0U;
  }
}

extern "C" __global__ __aicore__ void NativeSampleRowsKernel(
    GM_ADDR gradient, GM_ADDR hessian, GM_ADDR out_gradient, GM_ADDR out_hessian,
    uint32_t nrows, uint64_t seed, float subsample) {
  asc_vf_call<NativeSampleRowsVf>(dim3(128),
      reinterpret_cast<__gm__ uint32_t const*>(gradient),
      reinterpret_cast<__gm__ uint32_t const*>(hessian),
      reinterpret_cast<__gm__ uint32_t*>(out_gradient),
      reinterpret_cast<__gm__ uint32_t*>(out_hessian), nrows, seed, subsample,
      AscendC::GetBlockIdx(), AscendC::GetBlockNum());
}

extern "C" void XgbNpuNativeSampleRows(void* stream, void const* gradient, void const* hessian,
    void* out_gradient, void* out_hessian, uint32_t nrows, uint64_t seed, float subsample) {
  if (!nrows) return;
  uint32_t blocks = (nrows - 1) / 128 + 1;
  if (blocks > 16) blocks = 16;
  NativeSampleRowsKernel<<<blocks, nullptr, stream>>>(
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(gradient)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(hessian)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(out_gradient)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(out_hessian)), nrows, seed, subsample);
}